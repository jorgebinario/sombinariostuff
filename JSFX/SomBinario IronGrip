desc:SomBinario IronGrip (v1.0)
filename:0,sb_knob.png

slider1:0<0,24,0.1>-Drive (dB)
slider7:0<0,100,1>-Bite (%) 
slider2:0<-24,0,0.1>-Ceiling (dB)
slider3:100<0,100,1>-Softness (%)
slider4:100<0,100,1>-Mix (%)
slider5:0<0,3,1{Desligado,2x,4x,8x}>-Oversampling
slider6:0<-60,24,0.1>-Output (dB)

@init
function tanh_seguro(x) local(e2x) (
  x = min(max(x, -10), 10);
  e2x = exp(2 * x);
  (e2x - 1) / (e2x + 1);
);

function f4_set(f, sr) (
    this.bq1.w = 2 * 3.1415926535 * f / sr; this.bq1.cw = cos(this.bq1.w); this.bq1.alpha = sin(this.bq1.w) / (2 * 0.541196); this.bq1.a0_inv = 1 / (1 + this.bq1.alpha); this.bq1.a0 = ((1 - this.bq1.cw) * 0.5) * this.bq1.a0_inv; this.bq1.a1 = (1 - this.bq1.cw) * this.bq1.a0_inv; this.bq1.a2 = this.bq1.a0; this.bq1.b1 = (-2 * this.bq1.cw) * this.bq1.a0_inv; this.bq1.b2 = (1 - this.bq1.alpha) * this.bq1.a0_inv;
    this.bq2.w = 2 * 3.1415926535 * f / sr; this.bq2.cw = cos(this.bq2.w); this.bq2.alpha = sin(this.bq2.w) / (2 * 1.306563); this.bq2.a0_inv = 1 / (1 + this.bq2.alpha); this.bq2.a0 = ((1 - this.bq2.cw) * 0.5) * this.bq2.a0_inv; this.bq2.a1 = (1 - this.bq2.cw) * this.bq2.a0_inv; this.bq2.a2 = this.bq2.a0; this.bq2.b1 = (-2 * this.bq2.cw) * this.bq2.a0_inv; this.bq2.b2 = (1 - this.bq2.alpha) * this.bq2.a0_inv;
);
function f4_process(x) (
    this.bq1.y = this.bq1.a0*x + this.bq1.a1*this.bq1.x1 + this.bq1.a2*this.bq1.x2 - this.bq1.b1*this.bq1.y1 - this.bq1.b2*this.bq1.y2; this.bq1.x2 = this.bq1.x1; this.bq1.x1 = x; this.bq1.y2 = this.bq1.y1; this.bq1.y1 = this.bq1.y;
    this.bq2.y = this.bq2.a0*this.bq1.y + this.bq2.a1*this.bq2.x1 + this.bq2.a2*this.bq2.x2 - this.bq2.b1*this.bq2.y1 - this.bq2.b2*this.bq2.y2; this.bq2.x2 = this.bq2.x1; this.bq2.x1 = this.bq1.y; this.bq2.y2 = this.bq2.y1; this.bq2.y1 = this.bq2.y;
    this.bq2.y;
);

function process_knob(x, y, slider_num, min_val, max_val, init_val, title)
local(norm_val, frame, is_hover, text_w, img_w, img_h, slider_val, delta)
(
    slider_num == 1 ? slider_val = slider1 :
    slider_num == 2 ? slider_val = slider2 :
    slider_num == 3 ? slider_val = slider3 :
    slider_num == 4 ? slider_val = slider4 :
    slider_num == 7 ? slider_val = slider7 :
    slider_val = slider6;

    is_hover = (mouse_x >= x && mouse_x <= x + knob_w && mouse_y >= y && mouse_y <= y + knob_h);

    is_hover && mouse_cap == 1 && last_mouse_cap == 0 && active_knob == 0 ? (
        (time_precise() - last_click_time < 0.25) && (last_clicked_knob == slider_num) || (mouse_cap & 4) ? (
            slider_val = init_val;
            slider_num == 1 ? slider1 = slider_val :
            slider_num == 2 ? slider2 = slider_val :
            slider_num == 3 ? slider3 = slider_val :
            slider_num == 4 ? slider4 = slider_val :
            slider_num == 7 ? slider7 = slider_val :
            slider6 = slider_val;
            sliderchange(1 << (slider_num - 1));
            last_click_time = 0; 
            active_knob = 99; 
        ) : (
            last_click_time = time_precise();
            last_clicked_knob = slider_num;
            active_knob = slider_num;
            mouse_last_y = mouse_y;
        );
    );
    
    active_knob == slider_num && mouse_cap == 1 ? (
        delta = (mouse_last_y - mouse_y) * 0.5;
        slider_val = min(max(slider_val + delta * (max_val - min_val) / 100, min_val), max_val);
        
        slider_num == 1 ? slider1 = slider_val :
        slider_num == 2 ? slider2 = slider_val :
        slider_num == 3 ? slider3 = slider_val :
        slider_num == 4 ? slider4 = slider_val :
        slider_num == 7 ? slider7 = slider_val :
        slider6 = slider_val;
        
        sliderchange(1 << (slider_num - 1)); 
        mouse_last_y = mouse_y;
    );

    norm_val = (slider_val - min_val) / (max_val - min_val);
    frame = floor(norm_val * (knob_frames - 1));

    gfx_getimgdim(0, img_w, img_h);
    img_w > 0 ? (
        gfx_blit(0, 1, 0, 0, frame * knob_h, knob_w, knob_h, x, y, knob_w, knob_h);
    );

    gfx_setfont(1, "Arial", 14);
    gfx_r=0.8; gfx_g=0.8; gfx_b=0.8;
    gfx_measurestr(title, text_w, 0);
    gfx_x = x + (knob_w / 2) - (text_w / 2);
    gfx_y = y + knob_h + 10;
    gfx_drawstr(title);
    
    slider_num == 6 && slider_val <= -59.9 ? (
        sprintf(#val_str, "-inf");
    ) : (
        sprintf(#val_str, "%.1f", slider_val);
    );

    gfx_measurestr(#val_str, text_w, 0);
    gfx_x = x + (knob_w / 2) - (text_w / 2);
    gfx_y = y + knob_h + 30;
    gfx_r=0.9; gfx_g=0.4; gfx_b=0.0; 
    gfx_drawstr(#val_str);
);

knob_w = 100;
knob_h = 100;
knob_frames = 101; 
mouse_last_y = 0;
active_knob = 0;
last_mouse_cap = 0;
last_click_time = 0;
last_clicked_knob = 0;

@block
drive_lin = 10^(slider1/20);
ceil_lin = 10^(slider2/20);
pre_gain = drive_lin / ceil_lin; 
soft_pct = slider3 / 100; 
mix_pct = slider4 / 100;
out_gain_lin = (slider6 <= -59.9) ? 0.0 : 10^(slider6/20);

bite_amt = slider7 / 100;
drive_mod = min(max(slider1 / 12.0, 0.0), 1.0); 
dyn_bite = bite_amt * drive_mod;

new_os = (slider5 == 0) ? 1 : (slider5 == 1) ? 2 : (slider5 == 2) ? 4 : 8;
new_os != os_factor || srate != last_srate ? (
    os_factor = new_os;
    last_srate = srate;
    
    cutoff = srate * 0.45; 
    lp_l.f4_set(cutoff, srate * os_factor); 
    lp_r.f4_set(cutoff, srate * os_factor);
    
    att_f = 1.0 - exp(-1.0 / (0.001 * srate)); 
    rel_f = 1.0 - exp(-1.0 / (0.015 * srate)); 
    att_s = 1.0 - exp(-1.0 / (0.015 * srate)); 
    rel_s = 1.0 - exp(-1.0 / (0.100 * srate)); 
);

@sample
dry_l = spl0; dry_r = spl1;

abs_l = abs(spl0);
env_f_l += (abs_l > env_f_l ? att_f : rel_f) * (abs_l - env_f_l);
env_s_l += (abs_l > env_s_l ? att_s : rel_s) * (abs_l - env_s_l);
trans_l = max(env_f_l - env_s_l, 0.0); 

abs_r = abs(spl1);
env_f_r += (abs_r > env_f_r ? att_f : rel_f) * (abs_r - env_f_r);
env_s_r += (abs_r > env_s_r ? att_s : rel_s) * (abs_r - env_s_r);
trans_r = max(env_f_r - env_s_r, 0.0);

bite_gain_l = 1.0 + (trans_l * dyn_bite * 4.0); 
bite_gain_r = 1.0 + (trans_r * dyn_bite * 4.0); 

os_factor == 1 ? (
    in_l = spl0 * pre_gain;
    hc_l = min(max(in_l, -1.0), 1.0); 
    sc_l = tanh_seguro(in_l);         
    out_l = (sc_l * soft_pct) + (hc_l * (1.0 - soft_pct)); 

    in_r = spl1 * pre_gain;
    hc_r = min(max(in_r, -1.0), 1.0); 
    sc_r = tanh_seguro(in_r);         
    out_r = (sc_r * soft_pct) + (hc_r * (1.0 - soft_pct)); 
) : (
    step_l = (spl0 - last_spl0) / os_factor; step_r = (spl1 - last_spl1) / os_factor; 
    os_step = 1; 
    loop(os_factor,
        curr_l = last_spl0 + (step_l * os_step);
        in_l = curr_l * pre_gain;
        hc_l = min(max(in_l, -1.0), 1.0);
        sc_l = tanh_seguro(in_l);
        proc_l = (sc_l * soft_pct) + (hc_l * (1.0 - soft_pct));

        curr_r = last_spl1 + (step_r * os_step);
        in_r = curr_r * pre_gain;
        hc_r = min(max(in_r, -1.0), 1.0);
        sc_r = tanh_seguro(in_r);
        proc_r = (sc_r * soft_pct) + (hc_r * (1.0 - soft_pct));

        out_l = lp_l.f4_process(proc_l); 
        out_r = lp_r.f4_process(proc_r);
        os_step += 1;
    );
    last_spl0 = spl0; last_spl1 = spl1;
);

out_l *= bite_gain_l;
out_r *= bite_gain_r;

spl0 = (out_l * ceil_lin * mix_pct) + (dry_l * (1 - mix_pct));
spl1 = (out_r * ceil_lin * mix_pct) + (dry_r * (1 - mix_pct));
spl0 *= out_gain_lin; 
spl1 *= out_gain_lin;
spl0 = min(max(spl0, -1.0), 1.0); 
spl1 = min(max(spl1, -1.0), 1.0);

@gfx 650 600

// Armazena valores de desenho de forma estática para isolar do bypass do host
gfx_p_drive = slider1;
gfx_p_ceil = slider2;
gfx_p_soft = slider3;

v_drive = 10^(gfx_p_drive/20);
v_ceil = 10^(gfx_p_ceil/20);
v_pre = v_drive / v_ceil;
v_soft = gfx_p_soft / 100;

gfx_h < 250 ? (
    gfx_r=0.07; gfx_g=0.07; gfx_b=0.09; gfx_a=1.0;
    gfx_rect(0, 0, gfx_w, gfx_h);
    
    gfx_r=0.9; gfx_g=0.4; gfx_b=0.0; gfx_a=1.0;
    m_px = 0;
    loop(gfx_w,
        m_x_in = (m_px / max(gfx_w - 1, 1)) * 2.0 - 1.0;
        m_driven = m_x_in * v_pre;
        m_hc = min(max(m_driven, -1.0), 1.0);
        m_sc = tanh_seguro(m_driven);
        m_out = (m_sc * v_soft) + (m_hc * (1.0 - v_soft));
        m_out *= v_ceil;
        m_out = min(max(m_out, -1.01), 1.01);
        
        m_py = (gfx_h / 2) - (m_out * (gfx_h / 2) * 0.85);
        m_px == 0 ? (gfx_x = m_px; gfx_y = m_py;) : (gfx_lineto(m_px, m_py, 1););
        m_px += 1;
    );
) : (
    gfx_r=0.12; gfx_g=0.12; gfx_b=0.14; gfx_a=1.0;
    gfx_rect(0, 0, gfx_w, gfx_h);

    gfx_r=0.9; gfx_g=0.4; gfx_b=0.0;
    gfx_rect(0, 0, gfx_w, 40);
    gfx_r=1; gfx_g=1; gfx_b=1; gfx_setfont(1, "Arial", 18, 'b');
    gfx_x = 20; gfx_y = 10;
    gfx_drawstr("SOMBINÁRIO IRONGRIP");

    graph_w = 200;
    graph_h = 160;
    graph_x = (gfx_w - graph_w) / 2;
    graph_y = 60; 

    gfx_r=0.07; gfx_g=0.07; gfx_b=0.09; gfx_a=1.0;
    gfx_rect(graph_x, graph_y, graph_w, graph_h);
    gfx_r=0.3; gfx_g=0.3; gfx_b=0.3; gfx_a=1.0;
    gfx_line(graph_x, graph_y + graph_h/2, graph_x + graph_w, graph_y + graph_h/2);
    gfx_line(graph_x + graph_w/2, graph_y, graph_x + graph_w/2, graph_y + graph_h);

    gfx_r=0.9; gfx_g=0.4; gfx_b=0.0; gfx_a=1.0;
    px = 0; 
    loop(graph_w,
        x_in = (px / (graph_w - 1)) * 2.0 - 1.0;
        x_driven = x_in * v_pre; 
        hc_val = min(max(x_driven, -1.0), 1.0);
        sc_val = tanh_seguro(x_driven);
        y_out = (sc_val * v_soft) + (hc_val * (1.0 - v_soft));
        y_out *= v_ceil;
        y_out = min(max(y_out, -1.01), 1.01); 
        
        pixel_x = graph_x + px;
        pixel_y = graph_y + (graph_h / 2) - (y_out * (graph_h / 2));
        
        px == 0 ? (
            gfx_x = pixel_x;
            gfx_y = pixel_y;
        ) : (
            gfx_lineto(pixel_x, pixel_y, 1);
        );
        px += 1;
    );

    mouse_cap == 0 ? active_knob = 0;

    process_knob(60, 250, 1, 0, 24, 0.0, "Drive");
    process_knob(275, 250, 7, 0, 100, 0.0, "Bite"); 
    process_knob(490, 250, 2, -24, 0, 0.0, "Ceiling");

    process_knob(60, 410, 3, 0, 100, 100.0, "Softness");
    process_knob(275, 410, 4, 0, 100, 100.0, "Mix");
    process_knob(490, 410, 6, -60, 24, 0.0, "Output");

    gfx_x = 30; gfx_y = 560;
    gfx_r=0.6; gfx_g=0.6; gfx_b=0.6;
    gfx_drawstr("Oversampling: ");
    os_text = (slider5 == 0) ? "OFF" : (slider5 == 1) ? "2x" : (slider5 == 2) ? "4x" : "8x HQ";
    gfx_r=1; gfx_g=1; gfx_b=1;
    gfx_drawstr(os_text);

    mouse_cap == 1 && last_mouse_cap == 0 && mouse_x > 30 && mouse_x < 200 && mouse_y > 550 && mouse_y < 580 && active_knob == 0 ? (
        slider5 = (slider5 + 1) % 4; 
        sliderchange(16);
        active_knob = 99; 
    );
);

last_mouse_cap = mouse_cap;
