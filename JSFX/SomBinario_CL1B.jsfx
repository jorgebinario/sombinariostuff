);

init_tables();

// Recalcula os parâmetros do motor a partir dos sliders atuais.
// Chamada tanto em @slider (mudanças via host/automação) quanto
// diretamente pelo código de mouse em @gfx (mudanças via GUI custom),
// pra garantir efeito IMEDIATO independentemente de o host reprocessar
// ou não o bloco @slider a partir de slider_automate().
function update_engine()
(
  effect.CLCompressor_setParameters(
    (ratio_knob - 2.0) / 8.0,  // 2..10 -> 0..1
    threshold_db,
    ar_select,                  // 0=Fixed, 1=Fixed/Manual, 2=Manual
    attack_knob * 0.1,          // 0..10 -> 0..1
    release_knob * 0.1,         // 0..10 -> 0..1
    output_db
  );
);

// Recalcula wet/dry a partir do Mix - chamada tanto em @slider quanto
// direto no @gfx (mesma lógica de atualização imediata do update_engine).
function update_mix()
(
  wet = mix / 100;
  dry = 1 - wet;
);

(sample_rate != srate) ? (
  effect.CLCompressor_setSampleRate();
  sample_rate = srate;
);

effect.CLCompressor_reset();

// --- VU/GR meter: modelo de 2 polos em cascata (aprox. VU mecânico ANSI C16.5) ---
// tau escolhido para ~300ms de subida até 99% de um degrau (padrão de VU real).
vu_tau = 0.0452;
vu_k = exp(-1.0 / (max(1, srate) * vu_tau));

gr_meter_s1 = 0.0;
gr_meter_s2 = 0.0;
gr_meter = 0.0;

// pico de redução de ganho por bloco - alimenta o medidor NATIVO do
// REAPER (ext_gr_meter), independente do VU visual do plugin
hold_max_gr = 1.0;

// estado de interação da UI (arraste de knob/barra, duplo-clique pra reset)
drag_knob = 0;      // 0 = nenhum, 1-6 = índice do controle sendo arrastado
drag_start_y = 0;
drag_start_val = 0;
prev_left_down = 0;
prev_right_down = 0;
last_click_target = 0;
last_click_time = 0;

// estado de edição de valor por teclado (clicar no número embaixo do knob)
edit_target = 0;    // 0 = nenhum, 1-6 = qual controle está sendo editado
edit_str = "";

// ---- UI compacta (medidor de GR embutido no TCP/MCP do REAPER) ----
// Quando o usuário ativa "Show embedded UI in MCP"/"...in TCP" na faixa,
// o REAPER chama @gfx com uma janela BEM menor que a do plugin normal
// (a área do medidor da faixa/mixer, não a janela completa). Detectamos
// esse caso pelo tamanho recebido e, em vez de tentar encaixar a UI
// inteira (que não cabe), desenhamos só uma barra de redução de ganho.
function draw_compact_ui()
  local(gr_norm, mgn, bar_x, bar_y, bar_w, bar_h, fill_w, fill_h, fsize)
(
  gfx_r = 0.06; gfx_g = 0.06; gfx_b = 0.07; gfx_a = 1;
  gfx_rect(0, 0, gfx_w, gfx_h, 1);

  gr_norm = min(1, gr_meter / 24);
  mgn = 2;
  bar_x = mgn; bar_y = mgn;
  bar_w = gfx_w - mgn*2; bar_h = gfx_h - mgn*2;

  gfx_r=0.15; gfx_g=0.15; gfx_b=0.16; gfx_a=1;
  gfx_rect(bar_x, bar_y, bar_w, bar_h, 1);

  gfx_r=0.95; gfx_g=0.6; gfx_b=0.16; gfx_a=1;
  gfx_w >= gfx_h ? (
    // faixa larga e baixa (típico de TCP) - a barra enche da esquerda
    fill_w = bar_w * gr_norm;
    gfx_rect(bar_x, bar_y, fill_w, bar_h, 1);
  ) : (
    // faixa estreita e alta (típico de tira estreita de MCP) - enche de baixo pra cima
    fill_h = bar_h * gr_norm;
    gfx_rect(bar_x, bar_y + bar_h - fill_h, bar_w, fill_h, 1);
  );

  // rótulo "GR" com o valor em dB, só se tiver espaço legível
  (gfx_w > 46 && gfx_h > 12) ? (
    fsize = max(8, min(11, floor(gfx_h*0.5)));
    gfx_setfont(3, "Arial", fsize);
    gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.92;
    sprintf(#embtxt, "GR %.1f", gr_db);
    gfx_x = bar_x+3; gfx_y = bar_y + bar_h*0.5 - fsize*0.5;
    gfx_drawstr(#embtxt);
  );
);

// ---- UI completa (janela normal do plugin) ----
function draw_full_ui()
(

// trava a fonte explicitamente
gfx_setfont(1, "Arial", 15);

// --- PALETA DE CORES DARK MODE ---
c_bg_r = 0.08; c_bg_g = 0.08; c_bg_b = 0.09;
c_txt_r = 0.65; c_txt_g = 0.65; c_txt_b = 0.70;

gfx_r = c_bg_r; gfx_g = c_bg_g; gfx_b = c_bg_b; gfx_a = 1;
gfx_rect(0, 0, gfx_w, gfx_h);

// --- DETALHES DO CHASSI (abas de rack sutis) ---
gfx_r = 0.05; gfx_g = 0.05; gfx_b = 0.06;
gfx_rect(0, 0, 24, gfx_h);
gfx_rect(gfx_w - 24, 0, 24, gfx_h);

// ---- estado do mouse (uma vez por frame) ----
left_down = (mouse_cap&1) != 0;
just_pressed = left_down && !prev_left_down;
shift_held = (mouse_cap&8) != 0;
alt_held = (mouse_cap&16) != 0;

// ---- MESMAS posições/coordenadas do CL1B original ----
col1 = 250;  // Gain / Attack
col2 = 360;  // Ratio / Release
col3 = 470;  // Threshold / A-R Select
col4 = 570;  // Mix
col5 = 725;  // Bypass
row1 = 110;
row2 = 230;
kr_side = 32;

vu_x = 640; vu_y = 60; vu_w = 170; vu_h = 100;

ar_bw = 96; ar_bh = 28;
ar_bx = col3 - ar_bw*0.5; ar_by = row2 - ar_bh*0.5;

byp_bw = 76; byp_bh = 28;
byp_bx = col5 - byp_bw*0.5; byp_by = row2 - byp_bh*0.5;

// ---- um único bloco cinza, envolvendo tudo ----
draw_panel(26, 30, 804, 280);

// ---- título (sobre o bloco da esquerda) ----
gfx_r = 1; gfx_g = 1; gfx_b = 1; gfx_a = 1;
gfx_setfont(1, "Arial", 22, 'b');
gfx_x = 45; gfx_y = 120;
gfx_drawstr("SOMBINÁRIO");

gfx_setfont(2, "Arial", 13, 'b');
gfx_r = c_txt_r; gfx_g = c_txt_g; gfx_b = c_txt_b;
gfx_x = 45; gfx_y = 150;
gfx_drawstr("COMPRESSOR CL 1B");

gfx_setfont(3, "Arial", 11);
gfx_x = 45; gfx_y = 168;
gfx_drawstr("OPTICAL TUBE DYNAMICS");

bypass_on ? (
  gfx_setfont(2, "Arial", 13, 'b');
  gfx_r = 0.95; gfx_g = 0.50; gfx_b = 0.05;
  gfx_x = 45; gfx_y = 195;
  gfx_drawstr("[ BYPASSED ]");
);

// ---- detecta clique: Alt+clique ou duplo-clique reseta pro padrão;
// clique normal inicia o arraste (todos os 6 controles principais são
// knobs, incluindo Mix - como no CL1B original) ----
just_pressed ? (
  // se já havia edição em andamento, confirma o valor digitado antes
  // de processar este novo clique (evita perder o que foi digitado)
  edit_target != 0 ? (
    typed_val = parse_float(#edit_str);
    edit_target==1 ? ( slider(6) = min(24, max(-24, typed_val)); slider_automate(output_db); );
    edit_target==2 ? ( slider(1) = min(10, max(2, typed_val)); slider_automate(ratio_knob); );
    edit_target==3 ? ( slider(2) = min(10, max(-40, typed_val)); slider_automate(threshold_db); );
    edit_target==4 ? ( slider(7) = min(100, max(0, typed_val)); slider_automate(mix); update_mix(); );
    edit_target==5 ? ( slider(3) = min(10, max(0, typed_val)); slider_automate(attack_knob); );
    edit_target==6 ? ( slider(4) = min(10, max(0, typed_val)); slider_automate(release_knob); );
    edit_target != 4 ? update_engine();
    edit_target = 0;
  );

  target_id = 0;
  pt_in_circle(mouse_x,mouse_y,col1,row1,kr_side) ? target_id = 1;  // Gain
  target_id==0 && pt_in_circle(mouse_x,mouse_y,col2,row1,kr_side) ? target_id = 2;  // Ratio
  target_id==0 && pt_in_circle(mouse_x,mouse_y,col3,row1,kr_side) ? target_id = 3;  // Threshold
  target_id==0 && pt_in_circle(mouse_x,mouse_y,col4,row1,kr_side) ? target_id = 4;  // Mix
  target_id==0 && pt_in_circle(mouse_x,mouse_y,col1,row2,kr_side) ? target_id = 5;  // Attack
  target_id==0 && pt_in_circle(mouse_x,mouse_y,col2,row2,kr_side) ? target_id = 6;  // Release

  target_id != 0 ? (
    is_dblclick = (target_id == last_click_target) && (time_precise()-last_click_time < 0.35);

    (alt_held || is_dblclick) ? (
      target_id==1 ? ( slider(6) = 0;   slider_automate(output_db); );
      target_id==2 ? ( slider(1) = 6.0; slider_automate(ratio_knob); );
      target_id==3 ? ( slider(2) = 0;   slider_automate(threshold_db); );
      target_id==4 ? ( slider(7) = 100; slider_automate(mix); update_mix(); );
      target_id==5 ? ( slider(3) = 5.0; slider_automate(attack_knob); );
      target_id==6 ? ( slider(4) = 5.0; slider_automate(release_knob); );
      update_engine();
      drag_knob = 0;
    ) : (
      drag_knob = target_id;
      drag_start_y = mouse_y;
      target_id==1 ? drag_start_val = (output_db+24)/48;
      target_id==2 ? drag_start_val = (ratio_knob-2)/8;
      target_id==3 ? drag_start_val = (threshold_db+40)/50;
      target_id==4 ? drag_start_val = mix/100;
      target_id==5 ? drag_start_val = attack_knob/10;
      target_id==6 ? drag_start_val = release_knob/10;
    );

    last_click_target = target_id;
    last_click_time = time_precise();
  ) : (
    drag_knob = 0;
    // A/R Select: um único botão, clique cicla Fixed -> Fixed/Manual -> Manual
    pt_in_rect(mouse_x,mouse_y,ar_bx,ar_by,ar_bw,ar_bh) ? (
      slider(5) = (ar_select + 1) % 3;
      slider_automate(ar_select);
      update_engine();
    );
    // Bypass: toggle liga/desliga
    pt_in_rect(mouse_x,mouse_y,byp_bx,byp_by,byp_bw,byp_bh) ? (
      slider(8) = bypass_on ? 0 : 1;
      slider_automate(bypass);
      bypass_on = bypass >= 0.5;
    );
  );
);

// ---- botão direito num knob: abre edição do valor por teclado ----
right_down = (mouse_cap & 2) != 0;
just_right_pressed = right_down && !prev_right_down;

just_right_pressed ? (
  rt_target = 0;
  pt_in_circle(mouse_x,mouse_y,col1,row1,kr_side) ? rt_target = 1;  // Gain
  rt_target==0 && pt_in_circle(mouse_x,mouse_y,col2,row1,kr_side) ? rt_target = 2;  // Ratio
  rt_target==0 && pt_in_circle(mouse_x,mouse_y,col3,row1,kr_side) ? rt_target = 3;  // Threshold
  rt_target==0 && pt_in_circle(mouse_x,mouse_y,col4,row1,kr_side) ? rt_target = 4;  // Mix
  rt_target==0 && pt_in_circle(mouse_x,mouse_y,col1,row2,kr_side) ? rt_target = 5;  // Attack
  rt_target==0 && pt_in_circle(mouse_x,mouse_y,col2,row2,kr_side) ? rt_target = 6;  // Release

  rt_target != 0 ? (
    edit_target = rt_target;
    drag_knob = 0;
    rt_target==1 ? sprintf(#edit_str, "%.1f", output_db);
    rt_target==2 ? sprintf(#edit_str, "%.1f", ratio_knob);
    rt_target==3 ? sprintf(#edit_str, "%.1f", threshold_db);
    rt_target==4 ? sprintf(#edit_str, "%.0f", mix);
    rt_target==5 ? sprintf(#edit_str, "%.1f", attack_knob);
    rt_target==6 ? sprintf(#edit_str, "%.1f", release_knob);
  );
);

prev_right_down = right_down;

// ---- edição de valor por teclado (enquanto edit_target != 0) ----
edit_target != 0 ? (
  kb_char = gfx_getchar();
  while (kb_char != 0) (
    kb_char == 13 ? (
      // Enter: confirma
      typed_val = parse_float(#edit_str);
      edit_target==1 ? ( slider(6) = min(24, max(-24, typed_val)); slider_automate(output_db); );
      edit_target==2 ? ( slider(1) = min(10, max(2, typed_val)); slider_automate(ratio_knob); );
      edit_target==3 ? ( slider(2) = min(10, max(-40, typed_val)); slider_automate(threshold_db); );
      edit_target==4 ? ( slider(7) = min(100, max(0, typed_val)); slider_automate(mix); update_mix(); );
      edit_target==5 ? ( slider(3) = min(10, max(0, typed_val)); slider_automate(attack_knob); );
      edit_target==6 ? ( slider(4) = min(10, max(0, typed_val)); slider_automate(release_knob); );
      edit_target != 4 ? update_engine();
      edit_target = 0;
    ) : kb_char == 27 ? (
      // Escape: cancela, descarta o que foi digitado
      edit_target = 0;
    ) : kb_char == 8 ? (
      // Backspace
      strlen(#edit_str) > 0 ? str_setlen(#edit_str, strlen(#edit_str)-1);
    ) : (
      // aceita dígitos, ponto decimal, e sinal de menos só no início
      ((kb_char >= 48 && kb_char <= 57) || kb_char == 46 || (kb_char == 45 && strlen(#edit_str) == 0)) ?
        append_char(#edit_str, kb_char);
    );
    kb_char = gfx_getchar();
  );
);

// ---- scroll do mouse ----
mouse_wheel != 0 ? (
  wheel_notches = mouse_wheel / 120;
  mouse_wheel = 0;

  pt_in_circle(mouse_x,mouse_y,col1,row1,kr_side) ? (
    slider(6) = min(24, max(-24, output_db + wheel_notches*0.5));
    slider_automate(output_db); update_engine();
  );
  pt_in_circle(mouse_x,mouse_y,col2,row1,kr_side) ? (
    slider(1) = min(10, max(2, ratio_knob + wheel_notches*0.1));
    slider_automate(ratio_knob); update_engine();
  );
  pt_in_circle(mouse_x,mouse_y,col3,row1,kr_side) ? (
    slider(2) = min(10, max(-40, threshold_db + wheel_notches*0.5));
    slider_automate(threshold_db); update_engine();
  );
  pt_in_circle(mouse_x,mouse_y,col4,row1,kr_side) ? (
    slider(7) = min(100, max(0, mix + wheel_notches*2));
    slider_automate(mix); update_mix();
  );
  pt_in_circle(mouse_x,mouse_y,col1,row2,kr_side) ? (
    slider(3) = min(10, max(0, attack_knob + wheel_notches*0.1));
    slider_automate(attack_knob); update_engine();
  );
  pt_in_circle(mouse_x,mouse_y,col2,row2,kr_side) ? (
    slider(4) = min(10, max(0, release_knob + wheel_notches*0.1));
    slider_automate(release_knob); update_engine();
  );
);

// ---- atualiza o valor do knob sendo arrastado ----
(left_down && drag_knob != 0) ? (
  sens = shift_held ? 800 : 200;
  newval01 = drag_start_val + (drag_start_y-mouse_y)/sens;
  newval01 < 0 ? newval01 = 0;
  newval01 > 1 ? newval01 = 1;
  drag_knob==1 ? slider(6) = -24 + newval01*48;
  drag_knob==2 ? slider(1) = 2 + newval01*8;
  drag_knob==3 ? slider(2) = -40 + newval01*50;
  drag_knob==4 ? slider(7) = newval01*100;
  drag_knob==5 ? slider(3) = newval01*10;
  drag_knob==6 ? slider(4) = newval01*10;
  drag_knob==1 ? slider_automate(output_db);
  drag_knob==2 ? slider_automate(ratio_knob);
  drag_knob==3 ? slider_automate(threshold_db);
  drag_knob==4 ? slider_automate(mix);
  drag_knob==5 ? slider_automate(attack_knob);
  drag_knob==6 ? slider_automate(release_knob);
  update_engine();
  drag_knob==4 ? update_mix();
);

!left_down ? drag_knob = 0;
prev_left_down = left_down;

// ---- hover ----
hov_gain    = pt_in_circle(mouse_x,mouse_y,col1,row1,kr_side);
hov_ratio   = pt_in_circle(mouse_x,mouse_y,col2,row1,kr_side);
hov_thresh  = pt_in_circle(mouse_x,mouse_y,col3,row1,kr_side);
hov_mix     = pt_in_circle(mouse_x,mouse_y,col4,row1,kr_side);
hov_attack  = pt_in_circle(mouse_x,mouse_y,col1,row2,kr_side);
hov_release = pt_in_circle(mouse_x,mouse_y,col2,row2,kr_side);

// ---- os 6 knobs (estilo TubeGlow), nas posições originais ----
edit_target==1 ? sprintf(#vgain,"%s_",#edit_str) : sprintf(#vgain,"%.1f dB",output_db);
draw_knob_block(col1,row1,kr_side,(output_db+24)/48,hov_gain,"GAIN",#vgain,18);
edit_target==2 ? sprintf(#vrat,"%s_",#edit_str) : sprintf(#vrat,"%.1f:1",ratio_knob);
draw_knob_block(col2,row1,kr_side,(ratio_knob-2)/8,hov_ratio,"RATIO",#vrat,18);
edit_target==3 ? sprintf(#vthr,"%s_",#edit_str) : sprintf(#vthr,"%.1f dB",threshold_db);
draw_knob_block(col3,row1,kr_side,(threshold_db+40)/50,hov_thresh,"THRESHOLD",#vthr,18);
edit_target==4 ? sprintf(#vmix,"%s_",#edit_str) : sprintf(#vmix,"%.0f%%",mix);
draw_knob_block(col4,row1,kr_side,mix/100,hov_mix,"MIX",#vmix,18);
edit_target==5 ? sprintf(#vatt,"%s_",#edit_str) : sprintf(#vatt,"%.1f",attack_knob);
draw_knob_block(col1,row2,kr_side,attack_knob/10,hov_attack,"ATTACK",#vatt,18);
edit_target==6 ? sprintf(#vrel,"%s_",#edit_str) : sprintf(#vrel,"%.1f",release_knob);
draw_knob_block(col2,row2,kr_side,release_knob/10,hov_release,"RELEASE",#vrel,18);

// ---- A/R Select: label acima + botão único (sempre em destaque, cicla no clique) ----
gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; gfx_a=1;
gfx_setfont(3, "Arial", 10);
sprintf(#arlbl, "A/R SELECT");
gfx_measurestr(#arlbl, arlbl_w, arlbl_h);
gfx_x = col3 - arlbl_w*0.5; gfx_y = ar_by - 18;
gfx_drawstr(#arlbl);

set_ar_name(ar_select);
draw_toggle_button(ar_bx,ar_by,ar_bw,ar_bh, 1, 0.95,0.6,0.16, #artxt, #artxt);

// ---- Bypass: label acima + botão toggle (laranja=processando, apagado=bypassed) ----
gfx_setfont(3, "Arial", 10);
gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; gfx_a=1;
sprintf(#byplbl, "TRUE BYPASS");
gfx_measurestr(#byplbl, byplbl_w, byplbl_h);
gfx_x = col5 - byplbl_w*0.5; gfx_y = byp_by - 18;
gfx_drawstr(#byplbl);

draw_toggle_button(byp_bx,byp_by,byp_bw,byp_bh, !bypass_on, 0.95,0.6,0.16, "ON","OFF");

// ---- VU/GR meter (cascata de 2 polos, ver @sample) ----
cx = vu_x + vu_w * 0.5; cy = vu_y + vu_h + 10; radius = 100;

gfx_setfont(3, "Arial", 10);
gfx_r = c_txt_r; gfx_g = c_txt_g; gfx_b = c_txt_b; gfx_a = 1;
gfx_measurestr("GR (dB)", tw, th);
gfx_x = cx - tw / 2; gfx_y = vu_y - 16;
gfx_drawstr("GR (dB)");

gfx_r = 0.04; gfx_g = 0.04; gfx_b = 0.05; gfx_a = 1;
gfx_rect(vu_x, vu_y, vu_w, vu_h, 1);
gfx_r = 0.11; gfx_g = 0.11; gfx_b = 0.12;
gfx_rect(vu_x, vu_y, vu_w, vu_h, 0);

i = 0;
loop(11,
  a = 0.6 - (i / 10) * 1.2;
  is_major = (i % 5 == 0);
  len = is_major ? 14 : 7;
  i >= 8 ? (gfx_r = 0.95; gfx_g = 0.50; gfx_b = 0.05; gfx_a = 0.9;)
         : (gfx_r = 0.4; gfx_g = 0.4; gfx_b = 0.45; gfx_a = 0.6;);
  px1 = cx + sin(a) * (radius - len); py1 = cy - cos(a) * (radius - len);
  px2 = cx + sin(a) * radius; py2 = cy - cos(a) * radius;
  gfx_line(px1, py1, px2, py2);

  is_major ? (
    tick_db = i * 2.4;
    sprintf(#tick_lbl, "%d", tick_db);
    gfx_setfont(4, "Arial", 10, 'b');
    i >= 8 ? (gfx_r = 0.95; gfx_g = 0.50; gfx_b = 0.05; gfx_a = 1;)
           : (gfx_r = 0.9; gfx_g = 0.9; gfx_b = 0.92; gfx_a = 1;);
    gfx_measurestr(#tick_lbl, lbl_tw, lbl_th);
    lx = cx + sin(a) * (radius - len - 13) - lbl_tw / 2;
    ly = cy - cos(a) * (radius - len - 13) - lbl_th / 2;
    gfx_x = lx; gfx_y = ly;
    gfx_drawstr(#tick_lbl);
  );

  i += 1;
);

gr_norm = min(1, gr_meter / 24);
angle = 0.6 - (gr_norm * 1.2);
nx = cx + sin(angle) * (radius * 0.95); ny = cy - cos(angle) * (radius * 0.95);

gfx_r = 0.95; gfx_g = 0.50; gfx_b = 0.05; gfx_a = 1;
gfx_triangle(cx - 1.5, cy - 20, cx + 1.5, cy - 20, nx, ny);
gfx_r = 0.1; gfx_g = 0.1; gfx_b = 0.12;
gfx_circle(cx, cy - 20, 6, 1);
gfx_r = 0.3; gfx_g = 0.3; gfx_b = 0.35;
gfx_circle(cx, cy - 20, 6, 0);

);

@slider

// Mapeamento corrigido: attack_release_mode recebe o A/R Select (0/1/2),
// attack e release recebem os knobs 0..10 normalizados pra 0..1.
update_engine();

bypass_on = bypass >= 0.5;
update_mix();

// recalcula o coeficiente do VU meter caso o sample rate tenha mudado
vu_k = exp(-1.0 / (max(1, srate) * vu_tau));

@block

// Reporta a redução de ganho pro medidor NATIVO da faixa no REAPER
// (aquele indicador que "puxa" do topo do medidor de volume, sem
// precisar de UI embutida nenhuma). REAPER espera isso em dB, e lido
// uma vez por bloco - por isso o pico é acumulado em @sample e só
// convertido/resetado aqui.
ext_gr_meter = K_TO_DB(hold_max_gr);
hold_max_gr = 1.0;

@sample

bypass_on ? (
  gr_lin = 1;
) : (
  dry_l = spl0;
  dry_r = spl1;

  effect.CLCompressor_processSampleStereo(spl0, spl1);

  wet_l = effect.y1;
  wet_r = effect.y2;

  spl0 = dry_l * dry + wet_l * wet;
  spl1 = dry_r * dry + wet_r * wet;

  gr_lin = effect.gr;
);

hold_max_gr = min(hold_max_gr, gr_lin);

gr_db = max(0, -20 * log10(max(0.0001, gr_lin)));

// VU meter: 2 polos em cascata, mesmo tau -> resposta em S com inércia,
// bem mais próxima de uma agulha mecânica real do que exponencial de 1 polo.
gr_meter_s1 += (gr_db - gr_meter_s1) * (1.0 - vu_k);
gr_meter_s2 += (gr_meter_s1 - gr_meter_s2) * (1.0 - vu_k);
gr_meter = gr_meter_s2;

@gfx 860 330

// Detecta se estamos numa janela "de verdade" (plugin aberto normal,
// 860x330) ou numa área embutida bem menor (medidor no TCP/MCP do
// REAPER) - nesse segundo caso, cabe só o medidor de GR, não a UI toda.
is_embedded = gfx_w < 400 || gfx_h < 200;
is_embedded ? draw_compact_ui() : draw_full_ui();

