desc:SomBinario CL1B (v1.0)
options: gfx_hz=60
options: want_all_kb

// ============================================================
// SomBinário CL1B v1.0 - Compressor Óptico Valvulado
// Autor: Jorge Araujo (SomBinário)
//
// Simulação de um compressor óptico valvulado (baseado no Tube-Tech
// CL 1B), com motor por tabelas de resposta medida do hardware real.
// Controles: Threshold, Ratio, Attack, Release, A/R Select
// (Fixed / Fixed+Manual / Manual), Output Gain, Mix e Bypass.
// ============================================================

slider1:ratio_knob=6.0<2,10,0.1>-Ratio, :1
slider2:threshold_db=0<-40,10,0.1>-Threshold (dB)
slider3:attack_knob=5.0<0,10,0.1>-Attack
slider4:release_knob=5.0<0,10,0.1>-Release
slider5:ar_select=2<0,2,1{Fixed,Fixed/Manual,Manual}>-A/R Select
slider6:output_db=0<-24,24,0.1>-Output Gain (dB)
slider7:mix=100<0,100,1>-Mix (%)
slider8:bypass=0<0,1,1{Off,On}>-Bypass

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init

ext_gr_meter = 0.0;

function DB_TO_K(x)
(
  10 ^ (x / 20)
);

function K_TO_DB(x)
(
  20 * log10(x)
);

// for allocator
__memory_Index__ = 0;

function allocate(size) local(result)
(
  result = __memory_Index__;
   __memory_Index__ += size;
  result;
);

// interpolation helpers

M_LN2 = log(2);

function frexp(x) local(sign, a1)
(
  sign = 0;

  (x < 0.0) ? (
    x = -x;
    sign = 1;
  );

  frexp_exp = ceil(log(x) / M_LN2);

  a1 = x / pow(2.0, frexp_exp);

  (a1 == 1.0) ? (
    a1 = 0.5;
    frexp_exp += 1;
  );

  sign ? ( a1 = -a1; );

  a1;
);

function ldexp(a, b)
(
  a * pow(2.0, b);
);

function clamp(x)
(
  min(max(x, -0.99999988), 0.99999988);
);

// ============================================================
// UI compartilhada (mesmo estilo visual da linha SomBinário: anel de
// LEDs em quadradinhos ao redor do knob, corpo flat, painéis de
// agrupamento com cantos arredondados). Portado do TubeGlow v1.2 pra
// manter o padrão visual entre os plugins da linha.
// ============================================================

function pt_in_circle(mx, my, cx, cy, r)
  local(dx, dy)
(
  dx = mx-cx; dy = my-cy;
  (dx*dx + dy*dy) <= r*r;
);

function pt_in_rect(mx, my, rx, ry, rw, rh)
(
  mx >= rx && mx <= rx+rw && my >= ry && my <= ry+rh;
);

// retângulo com cantos arredondados (corpo + círculos nos cantos),
// usa a cor atual (gfx_r/g/b/a), sem borda
function draw_rrect(bx, by, bw, bh, rad)
(
  gfx_rect(bx+rad,by,bw-2*rad,bh,1);
  gfx_rect(bx,by+rad,bw,bh-2*rad,1);
  gfx_circle(bx+rad,by+rad,rad,1,1);
  gfx_circle(bx+bw-rad,by+rad,rad,1,1);
  gfx_circle(bx+rad,by+bh-rad,rad,1,1);
  gfx_circle(bx+bw-rad,by+bh-rad,rad,1,1);
);

// painel sutil de agrupamento (levemente mais claro que o fundo, sem borda)
function draw_panel(bx, by, bw, bh)
(
  gfx_r=0.13; gfx_g=0.13; gfx_b=0.13; gfx_a=1;
  draw_rrect(bx,by,bw,bh,10);
);

// anel de bolinhas ao redor do knob - acesa = laranja opaco, apagada =
// laranja translúcido ("adormecida"), acendendo progressivamente
// conforme o valor sobe (mesma lógica de antes, só que com círculos
// em vez de quadrados ou de um arco sólido contínuo)
function draw_led_ring(kx, ky, kr, val01, hovered, nticks)
  local(i, frac, ang, lit, bx, by)
(
  val01 < 0 ? val01 = 0;
  val01 > 1 ? val01 = 1;
  i = 0;
  loop(nticks,
    frac = nticks > 1 ? i/(nticks-1) : 0;
    ang = KNOB_ANG_MIN + frac*(KNOB_ANG_MAX-KNOB_ANG_MIN);
    lit = frac <= val01;
    gfx_r=0.95; gfx_g=0.6; gfx_b=0.16;
    lit ? ( gfx_a = hovered ? 1.0 : 0.9; ) : ( gfx_a = 0.13; );
    bx = kx+kr*sin(ang); by = ky-kr*cos(ang);
    gfx_circle(bx, by, 3, 1, 1);
    i += 1;
  );
  gfx_a = 1;
);

// corpo do knob: círculo liso e fosco com ponteiro reto - flat design
function draw_knob_flat(kx, ky, kr, val01, hovered)
  local(ang, br)
(
  val01 < 0 ? val01 = 0;
  val01 > 1 ? val01 = 1;
  br = kr - 12;

  gfx_r=0.17; gfx_g=0.17; gfx_b=0.18; gfx_a=1;
  gfx_circle(kx,ky,br,1,1);

  ang = KNOB_ANG_MIN + val01*(KNOB_ANG_MAX-KNOB_ANG_MIN);
  gfx_r=0.95; gfx_g=0.6; gfx_b=0.16;
  gfx_line(kx,ky, kx+(br-4)*sin(ang), ky-(br-4)*cos(ang), 1);
  gfx_circle(kx+(br-4)*sin(ang), ky-(br-4)*cos(ang), 2, 1, 1);
);

// texto do knob: valor abaixo (branco), label acima do anel (cinza claro)
function draw_knob_text(kx, ky, kr, label, valstr)
(
  gfx_setfont(3, "Arial", 10);
  gfx_r=0.6; gfx_g=0.6; gfx_b=0.62;
  sprintf(#lbltxt, "%s", label);
  gfx_x=kx-kr-10; gfx_y=ky-kr-22;
  gfx_drawstr(#lbltxt, 1, kx+kr+10, ky-kr-6);

  gfx_setfont(3, "Arial", 13);
  gfx_r=0.97; gfx_g=0.96; gfx_b=0.93;
  gfx_x=kx-kr-10; gfx_y=ky+kr+8;
  gfx_drawstr(valstr, 1, kx+kr+10, ky+kr+26);
);

// knob completo: LED ring + corpo flat + textos
function draw_knob_block(kx, ky, kr, val01, hovered, label, valstr, nticks)
(
  draw_led_ring(kx,ky,kr,val01,hovered,nticks);
  draw_knob_flat(kx,ky,kr,val01,hovered);
  draw_knob_text(kx,ky,kr,label,valstr);
);

// barra horizontal em blocos (Mix) - flat, com alpha no estado apagado
function draw_hbar(bx, by, bw, bh, val01, hovered, nblocks, label, valstr)
  local(i, litcount, blockw, gap, lx)
(
  val01 < 0 ? val01 = 0;
  val01 > 1 ? val01 = 1;

  gfx_setfont(3, "Arial", 10);
  gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; gfx_a=1;
  sprintf(#hbartxt, "%s", label);
  gfx_x=bx; gfx_y=by-18;
  gfx_drawstr(#hbartxt);

  gfx_r=0.97; gfx_g=0.96; gfx_b=0.93;
  gfx_x=bx; gfx_y=by-18;
  gfx_drawstr(valstr, 2, bx+bw, by-2);

  litcount = floor(val01*nblocks+0.5);
  gap=3;
  blockw = (bw-(nblocks-1)*gap)/nblocks;
  i=0;
  loop(nblocks,
    gfx_r=0.95; gfx_g=0.6; gfx_b=0.16;
    i<litcount ? ( gfx_a = hovered?1.0:0.9; ) : ( gfx_a = 0.13; );
    lx = bx+i*(blockw+gap);
    gfx_rect(lx,by,blockw,bh,1);
    i += 1;
  );
  gfx_a = 1;
);

// título de módulo (só texto sutil sobre o painel, sem caixa)
function draw_module_box(bx, by, bw, bh, title)
(
  gfx_setfont(3, "Arial", 10);
  gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; gfx_a=1;
  sprintf(#modtxt, "%s", title);
  gfx_x=bx; gfx_y=by+10;
  gfx_drawstr(#modtxt, 1, bx+bw, by+26);
);

// caixa de logo/título - texto centrado sobre painel sutil
function draw_logo_box(bx, by, bw, bh, text)
(
  gfx_r=0.13; gfx_g=0.13; gfx_b=0.13; gfx_a=1;
  draw_rrect(bx,by,bw,bh,10);

  sprintf(#logotxt, "%s", text);
  gfx_r=0.95; gfx_g=0.62; gfx_b=0.18;
  gfx_x = bx; gfx_y = by;
  gfx_drawstr(#logotxt, 1|4, bx+bw, by+bh);
);

// botão flat no padrão original do CL1B - retângulo reto (sem cantos
// arredondados), fundo escuro sólido, contorno tingido sutil (alpha
// baixo) e texto colorido - simétrico e discreto, sem "pílula" cheia
function draw_toggle_button(bx, by, bw, bh, on, on_r, on_g, on_b, ontext, offtext)
(
  gfx_r=0.12; gfx_g=0.12; gfx_b=0.14; gfx_a=1;
  gfx_rect(bx,by,bw,bh,1);

  on ? ( gfx_r=on_r; gfx_g=on_g; gfx_b=on_b; ) : ( gfx_r=0.3; gfx_g=0.3; gfx_b=0.35; );
  gfx_a=0.25;
  gfx_rect(bx,by,bw,bh,0);

  on ? ( gfx_r=on_r; gfx_g=on_g; gfx_b=on_b; ) : ( gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; );
  gfx_a=1;
  gfx_setfont(2,"Arial",11,'b');
  sprintf(#tgltxt, "%s", on ? ontext : offtext);
  gfx_measurestr(#tgltxt, tgl_tw, tgl_th);
  gfx_x = bx + bw*0.5 - tgl_tw*0.5;
  gfx_y = by + bh*0.5 - tgl_th*0.5;
  gfx_drawstr(#tgltxt);
);

// nomes dos 3 modos de A/R Select (usados na barra de seletor)
function set_ar_name(m)
(
  m==0 ? sprintf(#artxt, "FIXED");
  m==1 ? sprintf(#artxt, "FIX/MAN");
  m==2 ? sprintf(#artxt, "MANUAL");
);

// barra de seleção A/R - 3 botões, o ativo acende em âmbar
function draw_ar_bar(bx, by, bw, bh, btnw, gap, active)
  local(i, ix)
(
  i = 0;
  loop(3,
    ix = bx + i*(btnw+gap);
    i==active ? (
      gfx_r=0.95; gfx_g=0.6; gfx_b=0.16; gfx_a=1;
    ) : (
      gfx_r=0.13; gfx_g=0.13; gfx_b=0.13; gfx_a=1;
    );
    draw_rrect(ix,by,btnw,bh,6);

    i==active ? ( gfx_r=0.1; gfx_g=0.08; gfx_b=0.07; ) : ( gfx_r=0.6; gfx_g=0.6; gfx_b=0.62; );
    set_ar_name(i);
    gfx_x=ix; gfx_y=by;
    gfx_drawstr(#artxt, 1|4, ix+btnw, by+bh);
    i += 1;
  );
);

KNOB_ANG_MIN = -135 * $pi/180;
KNOB_ANG_MAX = 135 * $pi/180;

// converte uma string digitada (dígitos, ponto decimal, sinal de menos
// no início) em número - usado pra edição de parâmetro por teclado
function parse_float(str_ptr)
  local(i, len, c, sign, intpart, fracpart, fracdiv, seen_dot)
(
  len = strlen(str_ptr);
  i = 0; sign = 1; intpart = 0; fracpart = 0; fracdiv = 1; seen_dot = 0;
  (len > 0) && (str_getchar(str_ptr,0) == 45) ? ( sign = -1; i = 1; );
  while (i < len) (
    c = str_getchar(str_ptr, i);
    c == 46 ? (
      seen_dot = 1;
    ) : (
      (c >= 48 && c <= 57) ? (
        seen_dot ? (
          fracdiv *= 10;
          fracpart = fracpart*10 + (c-48);
        ) : (
          intpart = intpart*10 + (c-48);
        );
      );
    );
    i += 1;
  );
  sign * (intpart + fracpart/fracdiv);
);

// acrescenta um caractere (código ASCII) ao fim de uma string
function append_char(str_ptr, code)
  local(oldlen)
(
  oldlen = strlen(str_ptr);
  str_setlen(str_ptr, oldlen+1);
  str_setchar(str_ptr, oldlen, code);
);

function interpolate_lin(x, table_lin, table_size) local(index_int, index_frac)
(
  x = clamp(x);

  (x < 0.0) ?
    x = 0.0;

  x *= table_size - 1;

  index_int = floor(x);

  (index_int == table_size - 1) ? (

    table_lin[table_size - 1];

  ) : (

    index_frac = x - index_int;

    table_lin[index_int] * (1.0 - index_frac) + table_lin[index_int + 1] * index_frac;

  );
);

function interpolate_exp(x, table_exp, is_neg) local(exp, mant, index, frac)
(
  (is_neg) ? (
    // table_exp size is [48], with center index 23
    table_exp += 23;
  );

  x = clamp(x);

  (x * 1000000 == 0.0) ? (    // ??? WTF with JSFX here ??? (x == 0.0 doesn't work)

    table_exp[23];

  ) : (

    mant = frexp(x);
    exp = frexp_exp;

    index = 1 - exp;

    (index < 0) ?
      exp = 0;

    (index > 22) ? (
      frac = ldexp(mant, 22 + exp);
      index = 23;
    ) : (
      (mant <= 0.0) ? (
        frac = (mant + 0.5) * 2.0;
      ) : (
        frac = (mant - 0.5) * 2.0;
      );
    );

    (x < 0.0 && is_neg) ? (
      index = -index;   // negative index

      frac = frac + 1.0;  // negative frac
    );

    frac * (table_exp[index] - table_exp[index + 1]) + table_exp[index + 1];
  );
);

/*
 * CLCompressor
 */

AR_FIXED = 0;
AR_FIXED_MANUAL = 1;
AR_MANUAL = 2;

function CLCompressor_setSampleRate() local(lpf1_attack_sec, lpf1_release_sec, lpf2_attack_sec, lpf2_release_sec, release_sec)
(
  lpf1_attack_sec = 1.324200 * 0.001;
  lpf1_release_sec = 1.782562 * 0.001;

  lpf2_attack_sec = 28.011420 * 0.001;
  lpf2_release_sec = 26.260180 * 0.001;

  release_sec = 5.898;

  this.lpf1_attack = exp(-1.0 / (srate * lpf1_attack_sec));
  this.lpf1_release = exp(-1.0 / (srate * lpf1_release_sec));
  this.lpf2_attack = exp(-1.0 / (srate * lpf2_attack_sec));
  this.lpf2_release = exp(-1.0 / (srate * lpf2_release_sec));

  this.release_k = exp(-1.0 / (srate * release_sec));

  this.post_eq_k = 1.0 - exp(-2.0 * $pi * (20000.0 / srate));
);

function CLCompressor_reset()
(
  this.lpf1_state = 0.0;
  this.lpf2_state = 0.0;

  this.level_state = 0.0;

  this.post_eq_s1 = 0.0;
  this.post_eq_s2 = 0.0;
);

function CLCompressor_setParameters(ratio, threshold_dB, attack_release_mode, attack, release, output_gain_dB)
(
  this.T3 = interpolate_exp(ratio, table3_exp, 0);
  this.T10 = interpolate_exp(ratio, table10_exp, 0);
  this.T8 = interpolate_lin(attack, table8_lin, 46) * (44100.0 / srate);   // rescale table
  this.T9 = interpolate_lin(release, table9_lin, 24) * (44100.0 / srate);   // rescale table

  this.T4 = interpolate_lin(this.T3, table4_lin, 24);

  this.attack_release_mode = attack_release_mode;

  this.T7 = DB_TO_K(-40.0 - threshold_dB);    // interpolation table T7 not used
  this.T11 = DB_TO_K(-30.0 + output_gain_dB); // interpolation table T11 not used
);

function CLCompressor_processSampleStereo(x1, x2)
  local(
    inv_gr, gain_reduction, T5, T6, A1, B1, A2, B2, m1, m2,
    mult, T2_on, input1, input2, T12_1, T12_2, level_1, combined_level,
    T13, lpf1_k, lpf2_k, y1, y2
  )
(
  // feedback signal path
  inv_gr = this.lpf1_state * 0.2998201 + this.lpf2_state * 0.079904087;

  gain_reduction = 0.0029900903 / clamp(inv_gr + 0.0029900903);

  // feedback sidechain path

  T5 = interpolate_exp(inv_gr, table5_exp, 0);
  T6 = interpolate_lin(T5, table6_lin, 24);

  A1 = 0.01193628;
  B1 = 0.9323384;
  A2 = 0.4595526;
  B2 = 1.0;

  m1 = (A1 * T6 + B1 * (1.0 - T6));
  m2 = (A2 * T6 + B2 * (1.0 - T6));

  mult = m1 * (1.0 - this.T4) + m2 * this.T4;

  T2_on = 0.08098298;

  // detector path
  input1 = (x1 * T2_on) * mult * this.T7;
  input2 = (x2 * T2_on) * mult * this.T7;

  T12_1 = interpolate_exp(input1, table12_exp_neg, 1);
  T12_2 = interpolate_exp(input2, table12_exp_neg, 1);

  level_1 = max(abs(T12_1), abs(T12_2));    // stereo-link

  (this.attack_release_mode != AR_FIXED) ? (
    // attack/release
    (level_1 >= this.level_state) ? (
      // attack
      this.level_state = min(this.level_state + this.T8, level_1);
    ) : (
      // release
      this.level_state = max(this.level_state * this.release_k - this.T9, level_1);
    );
  );

  (this.attack_release_mode == AR_FIXED) ? (
    combined_level = level_1;
  ) : (
    (this.attack_release_mode == AR_MANUAL) ? (
      combined_level = this.level_state;
    ) : (
      combined_level = max(level_1, this.level_state);
    );
  );

  T13 = interpolate_lin(combined_level, table13_lin, 252);

  // lpf1
  lpf1_k = (T13 > this.lpf1_state) ? this.lpf1_attack : this.lpf1_release;

  this.lpf1_state = T13 + (this.lpf1_state - T13) * lpf1_k;

  // lpf2
  lpf2_k = (T13 > this.lpf2_state) ? this.lpf2_attack : this.lpf2_release;

  this.lpf2_state = T13 + (this.lpf2_state - T13) * lpf2_k;

  // output
  y1 = x1 * this.T10 * this.T11 * gain_reduction * 33.768673;
  y2 = x2 * this.T10 * this.T11 * gain_reduction * 33.768673;

  this.gr = gain_reduction;

  // post_eq
  this.post_eq_s1 += (y1 - this.post_eq_s1) * this.post_eq_k;
  this.post_eq_s2 += (y2 - this.post_eq_s2) * this.post_eq_k;

  this.y1 = this.post_eq_s1;
  this.y2 = this.post_eq_s2;
);

//=========== table of measured values ============

function init_tables() local(i)
(
  // T3
  table3_exp = allocate(25);
  table3_exp[0] = 0.999999;
  table3_exp[1] = 0.99;
  table3_exp[2] = 0.5626293;
  table3_exp[3] = 0.2993541;
  table3_exp[4] = 0.1536661;
  table3_exp[5] = 0.07558671;
  table3_exp[6] = 0.036547;
  table3_exp[7] = 0.01702715;

  i = 8;
  loop(25 - 8,
    table3_exp[i] = 0.01;
    i += 1;
  );

  // T4
  table4_lin = allocate(24);
  table4_lin[0] = 0;
  table4_lin[1] = 0.03416149;
  table4_lin[2] = 0.07852706;
  table4_lin[3] = 0.1228926;
  table4_lin[4] = 0.1672582;
  table4_lin[5] = 0.2116238;
  table4_lin[6] = 0.2559893;
  table4_lin[7] = 0.3003549;
  table4_lin[8] = 0.3447205;
  table4_lin[9] = 0.3890861;
  table4_lin[10] = 0.4334517;
  table4_lin[11] = 0.4778172;
  table4_lin[12] = 0.5221828;
  table4_lin[13] = 0.5665483;
  table4_lin[14] = 0.6109139;
  table4_lin[15] = 0.6552795;
  table4_lin[16] = 0.6996451;
  table4_lin[17] = 0.7440106;
  table4_lin[18] = 0.7883762;
  table4_lin[19] = 0.8327418;
  table4_lin[20] = 0.8771074;
  table4_lin[21] = 0.921473;
  table4_lin[22] = 0.9658385;
  table4_lin[23] = 0.999999;

  // T5
  table5_exp = allocate(25);
  table5_exp[0] = 0.01;
  table5_exp[1] = 1;
  table5_exp[2] = 0.9947661;
  table5_exp[3] = 0.9844928;
  table5_exp[4] = 0.9651101;
  table5_exp[5] = 0.9302186;
  table5_exp[6] = 0.8630559;
  table5_exp[7] = 0.755419;
  table5_exp[8] = 0.6082814;
  table5_exp[9] = 0.4397123;
  table5_exp[10] = 0.2796561;
  table5_exp[11] = 0.162245;
  table5_exp[12] = 0.08780019;
  table5_exp[13] = 0.04508;
  table5_exp[14] = 0.02209106;
  table5_exp[15] = 0.01019185;
  table5_exp[16] = 0.004130001;
  table5_exp[17] = 0.001069335;
  table5_exp[18] = 0.00001000000;
  table5_exp[19] = 0.00001000000;
  table5_exp[20] = 0.00001000000;
  table5_exp[21] = 0.00001000000;
  table5_exp[22] = 0.00001000000;
  table5_exp[23] = 0.00001000000;
  table5_exp[24] = 0.00001000000;

  // T6
  table6_lin = allocate(24);
  table6_lin[0] = 0;
  table6_lin[1] = 0.0434687;
  table6_lin[2] = 0.08694739;
  table6_lin[3] = 0.1304261;
  table6_lin[4] = 0.1739048;
  table6_lin[5] = 0.2173835;
  table6_lin[6] = 0.2608622;
  table6_lin[7] = 0.3043409;
  table6_lin[8] = 0.3478196;
  table6_lin[9] = 0.3912983;
