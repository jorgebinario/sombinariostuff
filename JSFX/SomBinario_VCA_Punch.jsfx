@block
threshold_db = slider1;
ratio_mode = floor(slider2 + 0.5);
ratio_value = ratio_mode == 0 ? 1.5 : ratio_mode == 1 ? 2.0 : ratio_mode == 2 ? 3.0 : ratio_mode == 3 ? 4.0 : 10.0;
attack_ms = slider3;
release_s = slider4;
auto_release = slider5;
crest_amount = slider6;
knee_mode = floor(slider7 + 0.5);
knee_width = knee_mode == 0 ? 12.0 : knee_mode == 1 ? 6.0 : 0.0;
thrust_amount = slider8;
makeup_db = slider9;
mix_amount = slider10;
thd_amount = slider11;
out_db = slider12;
vu_src = floor(slider13 + 0.5);

attack_coeff = exp(-1 / max(1, attack_ms * 0.001 * srate));
release_coeff = exp(-1 / max(1, release_s * srate));
auto_fast_coeff = exp(-1 / max(1, 0.04 * srate));
detector_coeff = exp(-1 / max(1, 0.010 * srate));

gr_meter_rise = 1 - exp(-1 / max(1, 0.003 * srate));
gr_meter_fall = 1 - exp(-1 / max(1, 0.05 * srate));

gb_attack_coeff = exp(-1 / max(1, 0.0002 * srate));
gb_release_coeff = exp(-1 / max(1, 0.020 * srate));

vu_coeff = 1 - exp(-1 / max(1, 0.300 * srate));

// ---------------------------------------------------------------------
// Auto makeup: devolve a reducao que o compressor aplicaria a um sinal em
// -10 dBFS, tres decibeis abaixo. Referenciar em 0 dBFS compensaria demais,
// porque programa de barramento nao mora perto do topo.
// ---------------------------------------------------------------------
auto_makeup = floor(slider14 + 0.5);

auto_makeup ? (
  amk_over = -10 - threshold_db;

  knee_width > 0 ? (
    amk_over <= -knee_width * 0.5 ? (
      amk_comp = 0;
    ) : amk_over >= knee_width * 0.5 ? (
      amk_comp = amk_over;
    ) : (
      amk_comp = sqr(amk_over + knee_width * 0.5) / (2 * knee_width);
    );
  ) : (
    amk_comp = max(0, amk_over);
  );

  amk_target = max(0, min(24, amk_comp * (1 - 1 / ratio_value) - 3));

  abs(slider9 - amk_target) > 0.05 ? (
    slider9 = amk_target;
    slider_automate(slider9);
  );

  makeup_db = slider9;
);

thrust_linear = thrust_amount * 0.01;
makeup_linear = pow(10, makeup_db / 20);
mix_linear = mix_amount * 0.01;
thd_linear = thd_amount * 0.01;
crest_linear = crest_amount * 0.01;
out_linear = pow(10, out_db / 20);

// coeficientes do Thrust: so recalcula quando muda de verdade
(thrust_linear != last_thrust_c || srate != last_srate_c) ? (
  make_tilt(thrust_linear);
  last_thrust_c = thrust_linear;
  last_srate_c = srate;
);

param_sm = 1 - exp(-1 / max(1, 0.030 * srate));

sm_init == 0 ? (
  thd_sm = thd_linear;
  makeup_sm = makeup_linear;
  mix_sm = mix_linear;
  out_sm = out_linear;
  sm_init = 1;
);

// Desbalanco L/R medido no aparelho (~0.57 dB entre os dois transformadores),
// aplicado simetrico para nao mexer no nivel geral.
lr_l = 0.9678; lr_r = 1.0333;

@sample
input_l = spl0;
input_r = spl1;

thd_sm += (thd_linear - thd_sm) * param_sm;
makeup_sm += (makeup_linear - makeup_sm) * param_sm;
mix_sm += (mix_linear - mix_sm) * param_sm;
out_sm += (out_linear - out_sm) * param_sm;

// ---- Thrust: tilt no sinal, por canal, e so entao retificacao ----
tilt_l = tilt_run(input_l, scl_x1, scl_y1);
tilt_r = tilt_run(input_r, scr_x1, scr_y1);

thrust_sidechain = (abs(tilt_l) + abs(tilt_r)) * 0.5 + 0.000000001;

peak_env = max(thrust_sidechain, peak_env * detector_coeff);
peak_db = 20 * log10(max(0.000000001, peak_env));

detector_rms += (thrust_sidechain * thrust_sidechain - detector_rms) * (1 - detector_coeff);
rms_db = 20 * log10(max(0.000000001, sqrt(detector_rms)));

detector_db = peak_db * (1 - crest_linear) + rms_db * crest_linear;

over_db = detector_db - threshold_db;

knee_width > 0 ? (
  over_db <= -knee_width * 0.5 ? (
    compressed_over = 0;
  ) : over_db >= knee_width * 0.5 ? (
    compressed_over = over_db;
  ) : (
    compressed_over = sqr(over_db + knee_width * 0.5) / (2 * knee_width);
  );
) : (
  compressed_over = max(0, over_db);
);

target_gr = compressed_over * (1 - 1 / ratio_value);
target_gain = pow(10, -target_gr / 20);

target_gain < gain_smoothed ? (
  gain_smoothed = target_gain + attack_coeff * (gain_smoothed - target_gain);
) : (
  auto_release > 0.5 ? (
    diff_db = -20 * log10(max(0.000000001, gain_smoothed)) - target_gr;
    auto_blend = min(1, max(0, diff_db / 6));
    auto_coeff = auto_fast_coeff * auto_blend + release_coeff * (1 - auto_blend);
    gain_smoothed = target_gain + auto_coeff * (gain_smoothed - target_gain);
  ) : (
    gain_smoothed = target_gain + release_coeff * (gain_smoothed - target_gain);
  );
);

gr_db = max(0, -20 * log10(max(0.0000001, gain_smoothed)));

gr_meter_coeff = gr_db > gr_meter ? gr_meter_rise : gr_meter_fall;
gr_meter += (gr_db - gr_meter) * gr_meter_coeff;

ext_gr_meter = -gr_meter;

wet_l = input_l * gain_smoothed * makeup_sm;
wet_r = input_r * gain_smoothed * makeup_sm;

// =====================================================================
// ESTAGIO DO TRANSFORMADOR
// Roda sempre. Com THD em 0 o blend zera o caminho e a saida e transparente,
// mas os filtros seguem aquecidos, entao sair do zero nao da tranco.
// =====================================================================
(
  drive = 1 + thd_sm * 3;

  gb_l_in = wet_l * lr_l;
  gb_r_in = wet_r * lr_r;

  // Envelope independente por canal: um transformador por canal, cada um
  // reagindo so ao proprio conteudo. O detector usa o mesmo tilt do Thrust,
  // entao Thrust alto faz o estagio reagir menos a grave e mais a agudo.
  // O audio processado continua sendo banda inteira; so o que DISPARA a
  // saturacao e que tem a resposta inclinada.
  gb_detect_l = abs(tilt_run(gb_l_in, stl_x1, stl_y1));
  gb_detect_r = abs(tilt_run(gb_r_in, str_x1, str_y1));

  gb_coeff_l = gb_detect_l > gb_env_l ? gb_attack_coeff : gb_release_coeff;
  gb_env_l = gb_detect_l + gb_coeff_l * (gb_env_l - gb_detect_l);
  gb_coeff_r = gb_detect_r > gb_env_r ? gb_attack_coeff : gb_release_coeff;
  gb_env_r = gb_detect_r + gb_coeff_r * (gb_env_r - gb_detect_r);

  gb_gain_l = gb_limiter_gain(gb_env_l, drive);
  gb_gain_r = gb_limiter_gain(gb_env_r, drive);

  // Reducao de ganho pura tira energia sem nada para compensar. Hardware que
  // satura troca parte do fundamental por energia harmonica, e e por isso que
  // continua soando grande enquanto reduz ganho. O blend abaixo devolve essa
  // parte na proporcao do quanto o limitador esta trabalhando agora.
  gb_grit_l = 1.0 - gb_gain_l;
  gb_grit_r = 1.0 - gb_gain_r;

  lin_l = gb_l_in * gb_gain_l;
  lin_r = gb_r_in * gb_gain_r;
  shp_l = gb_shaper(gb_l_in * drive) / drive;
  shp_r = gb_shaper(gb_r_in * drive) / drive;

  sat_l = lin_l * (1.0 - gb_grit_l) + shp_l * gb_grit_l;
  sat_r = lin_r * (1.0 - gb_grit_r) + shp_r * gb_grit_r;

  wet_l = wet_l * (1 - thd_sm) + sat_l * thd_sm;
  wet_r = wet_r * (1 - thd_sm) + sat_r * thd_sm;
);

spl0 = (input_l * (1 - mix_sm) + wet_l * mix_sm) * out_sm;
spl1 = (input_r * (1 - mix_sm) + wet_r * mix_sm) * out_sm;

// ---- medicao ----
in_peak  = max(in_peak,  max(abs(input_l), abs(input_r)));
out_peak = max(out_peak, max(abs(spl0), abs(spl1)));

mono_in  = (input_l + input_r) * 0.5;
mono_out = (spl0 + spl1) * 0.5;
vu_sq_in  += (mono_in  * mono_in  - vu_sq_in)  * vu_coeff;
vu_sq_out += (mono_out * mono_out - vu_sq_out) * vu_coeff;

@gfx 800 376
gfx_getchar();

// ---------------------------------------------------------------------
// ---------------------------------------------------------------------
// Historico do osciloscopio
// ---------------------------------------------------------------------
cur_out_db = 20 * log10(max(0.0001, out_peak));
cur_in_db  = 20 * log10(max(0.0001, in_peak));
out_peak = 0; in_peak = 0;

scope_lvl[scope_pos] = cur_out_db;
scope_gr[scope_pos]  = gr_meter;
scope_pos += 1;
scope_pos >= SCOPE_N ? scope_pos = 0;

// Retencao de pico: ao bater um valor novo o numero congela por um instante,
// e so depois volta a cair. Sem isso a leitura muda rapido demais para ser
// lida. 40 quadros a 60 Hz sao dois tercos de segundo.
HOLD_FRAMES = 40;

gr_meter >= shown_gr ? (
  shown_gr = gr_meter;
  gr_hold = HOLD_FRAMES;
) : (
  gr_hold > 0 ? ( gr_hold -= 1; ) : ( shown_gr = max(gr_meter, shown_gr - 1.5); );
);

cur_out_db >= shown_out ? (
  shown_out = cur_out_db;
  out_hold = HOLD_FRAMES;
) : (
  out_hold > 0 ? ( out_hold -= 1; ) : ( shown_out = max(cur_out_db, shown_out - 3); );
);

// ---------------------------------------------------------------------
// Fundo e cabecalho
// ---------------------------------------------------------------------
col_bg(); gfx_rect(0, 0, gfx_w, gfx_h, 1);

gfx_setfont(1, "Arial", 11, 'b');
col_accent(1); gfx_x = MARGIN + 2; gfx_y = 14; gfx_drawstr("SOMBINARIO");

gfx_setfont(2, "Arial", 21, 'b');
col_title(); gfx_x = MARGIN + 2; gfx_y = 27; gfx_drawstr("VCA Punch");

num_right = SCOPE_X + SCOPE_W;

gfx_setfont(1, "Arial", 11, 'b');
col_label();
txt_r("GR",  num_right - 100, 16);
txt_r("OUT", num_right, 16);

gfx_setfont(2, "Arial", 21, 'b');
col_accent(1);
sprintf(#s, "-%.1f", shown_gr);
txt_r(#s, num_right - 100, 30);

col_signal(1);
sprintf(#s, "%.1f", max(-99, shown_out));
txt_r(#s, num_right, 30);

// ---------------------------------------------------------------------
// Osciloscopio
// ---------------------------------------------------------------------
col_panel(); gfx_rect(SCOPE_X, SCOPE_Y, SCOPE_W, SCOPE_H, 1);

col_grid();
g_i = 1;
loop(4,
  gy = y_for_db(-12 * g_i);
  gfx_line(SCOPE_X, gy, SCOPE_X + SCOPE_PLOT_W, gy);
  g_i += 1;
);

// linha do threshold
thr_y = y_for_db(slider1);
gfx_set(0.239, 0.251, 0.282, 1);
dx = 0;
loop(floor(SCOPE_PLOT_W / 12),
  gfx_line(SCOPE_X + dx, thr_y, SCOPE_X + dx + 6, thr_y);
  dx += 12;
);

// envelope de nivel e curva de reducao
px_step = SCOPE_PLOT_W / (SCOPE_N - 1);
s_i = 0;
prev_lx = 0; prev_ly = 0; prev_gy = 0;
loop(SCOPE_N,
  idx = scope_pos + s_i;
  idx >= SCOPE_N ? idx -= SCOPE_N;

  lx = SCOPE_X + s_i * px_step;
  ly = y_for_db(scope_lvl[idx]);
  gy = y_for_db(-scope_gr[idx]);

  col_signal(0.22);
  gfx_line(lx, ly, lx, SCOPE_Y + SCOPE_H);

  s_i > 0 ? (
    col_signal(0.85);
    gfx_line(prev_lx, prev_ly, lx, ly, 1);
    col_accent(1);
    gfx_line(prev_lx, prev_gy, lx, gy, 1);
    gfx_line(prev_lx, prev_gy - 1, lx, gy - 1, 1);
  );

  prev_lx = lx; prev_ly = ly; prev_gy = gy;
  s_i += 1;
);

// escala em dB
gfx_setfont(1, "Arial", 11);
gfx_set(0.337, 0.369, 0.404, 1);
d_i = 0;
loop(5,
  txt_r(sprintf(#s, "%d", -12 * d_i), SCOPE_X + SCOPE_W - 2, y_for_db(-12 * d_i) - 7);
  d_i += 1;
);

// ---------------------------------------------------------------------
// VU analogico
// ---------------------------------------------------------------------
col_panelalt(); gfx_rect(VU_X, VU_Y, VU_W, VU_H, 1);

vu_cx = VU_X + VU_W * 0.5;
vu_cy = VU_Y + 86;
vu_r  = 58;

gfx_set(0.200, 0.220, 0.247, 1);
thick_arc(vu_cx, vu_cy, vu_r, -1.047, 1.047, 2);

gfx_set(0.784, 0.271, 0.165, 1);
thick_arc(vu_cx, vu_cy, vu_r, 0.611, 1.047, 3);

// marcas
gfx_setfont(1, "Arial", 10);
m_i = 0;
loop(6,
  mf = m_i == 0 ? 0 : m_i == 1 ? 0.22 : m_i == 2 ? 0.44 : m_i == 3 ? 0.62 : m_i == 4 ? 0.79 : 1.0;
  ma = -1.047 + mf * 2.094;
  mf >= 0.62 ? gfx_set(0.847, 0.380, 0.290, 1) : gfx_set(0.369, 0.400, 0.435, 1);
  gfx_line(vu_cx + sin(ma)*(vu_r-7), vu_cy - cos(ma)*(vu_r-7),
           vu_cx + sin(ma)*vu_r,     vu_cy - cos(ma)*vu_r);
  txt_c(m_i == 0 ? "-20" : m_i == 1 ? "-10" : m_i == 2 ? "-5" :
        m_i == 3 ? "0" : m_i == 4 ? "+2" : "+3",
        vu_cx + sin(ma)*(vu_r-17), vu_cy - cos(ma)*(vu_r-17) - 5);
  m_i += 1;
);

gfx_set(0.306, 0.337, 0.373, 1);
gfx_setfont(1, "Arial", 10, 'b');
txt_c("VU", vu_cx, vu_cy - 28);

// ponteiro
vu_src == 2 ? (
  vu_frac = max(0, min(1, 0.62 - gr_meter / 20 * 0.62));
) : (
  vu_db = 20 * log10(max(0.000001, sqrt(vu_src == 1 ? vu_sq_in : vu_sq_out))) + 9;
  vu_frac = max(0, min(1, (vu_db + 20) / 23));
);

vu_a = -1.047 + vu_frac * 2.094;
gfx_set(0.910, 0.925, 0.945, 1);
gfx_line(vu_cx, vu_cy, vu_cx + sin(vu_a)*(vu_r-8), vu_cy - cos(vu_a)*(vu_r-8), 1);
gfx_set(0.165, 0.180, 0.208, 1);
gfx_circle(vu_cx, vu_cy, 5, 1, 1);
gfx_set(0.545, 0.576, 0.612, 1);
gfx_circle(vu_cx, vu_cy, 2, 1, 1);

// seletor de fonte
gfx_setfont(1, "Arial", 11);
p_i = 0;
loop(3,
  px = VU_X + 4 + p_i * (PILL_W + 2);
  p_i == vu_src ? (
    col_accent(1); gfx_rect(px, PILL_Y, PILL_W, 19, 1);
    gfx_set(0.165, 0.102, 0.031, 1);
  ) : (
    gfx_set(0.137, 0.153, 0.176, 1); gfx_rect(px, PILL_Y, PILL_W, 19, 1);
    gfx_set(0.475, 0.506, 0.545, 1);
  );
  txt_c(p_i == 0 ? "out" : p_i == 1 ? "in" : "gr", px + PILL_W*0.5, PILL_Y + 4);
  p_i += 1;
);

// ---------------------------------------------------------------------
// Knobs
// ---------------------------------------------------------------------
slot_i = 0;
loop(12,
  col = slot_i % 6;
  row = floor(slot_i / 6);
  cell_x = MARGIN + col * CELL_W;
  cell_y = row == 0 ? ROW1_Y : ROW2_Y;
  k_cx = cell_x + CELL_W * 0.5;
  k_cy = cell_y + 38;

  slot_i == 0 ? ( k_norm = (slider1 + 50) / 65; k_lbl = "THRESHOLD"; sprintf(#k_val, "%.1f dB", slider1); ) :
  slot_i == 1 ? ( k_lbl = "RATIO";
                  slider2 == 0 ? strcpy(#k_val, "1.5:1") :
                  slider2 == 1 ? strcpy(#k_val, "2:1") :
                  slider2 == 2 ? strcpy(#k_val, "3:1") :
                  slider2 == 3 ? strcpy(#k_val, "4:1") : strcpy(#k_val, "10:1"); ) :
  slot_i == 2 ? ( k_norm = (slider3 - 0.1) / 29.9; k_lbl = "ATTACK"; sprintf(#k_val, "%.1f ms", slider3); ) :
  slot_i == 3 ? ( k_norm = (slider4 - 0.05) / 2.95; k_lbl = "RELEASE"; sprintf(#k_val, "%.2f s", slider4); ) :
  slot_i == 4 ? ( k_lbl = "AUTO REL"; slider5 > 0.5 ? strcpy(#k_val, "dual") : strcpy(#k_val, "manual"); ) :
  slot_i == 5 ? ( k_norm = slider6 / 100; k_lbl = "CREST"; sprintf(#k_val, "%.0f %%", slider6); ) :
  slot_i == 6 ? ( k_lbl = "KNEE";
                  slider7 == 0 ? strcpy(#k_val, "soft") :
                  slider7 == 1 ? strcpy(#k_val, "medium") : strcpy(#k_val, "hard"); ) :
  slot_i == 7 ? ( k_norm = slider8 / 100; k_lbl = "THRUST"; sprintf(#k_val, "%.0f %%", slider8); ) :
  slot_i == 8 ? ( k_norm = slider9 / 24; k_lbl = "MAKEUP"; sprintf(#k_val, "%.1f dB", slider9); ) :
  slot_i == 9 ? ( k_norm = slider10 / 100; k_lbl = "MIX"; sprintf(#k_val, "%.0f %%", slider10); ) :
  slot_i == 10 ? ( k_norm = slider11 / 100; k_lbl = "THD"; sprintf(#k_val, "%.0f %%", slider11); ) :
                 ( k_norm = (slider12 + 18) / 36; k_lbl = "OUTPUT"; sprintf(#k_val, "%.1f dB", slider12); );

  is_btn = (slot_i == 1 || slot_i == 4 || slot_i == 6);

  gfx_setfont(1, "Arial", 11, 'b');
  col_label(); txt_c(k_lbl, k_cx, cell_y);

  is_btn ? (
    col_accent(1);
    gfx_rect(k_cx - 46, k_cy - 14, 92, 28, 1);
    gfx_set(0.165, 0.102, 0.031, 1);
    gfx_setfont(1, "Arial", 12, 'b');
    txt_c(#k_val, k_cx, k_cy - 7);
  ) : (
    k_r = 21;
    k_a = -2.356 + k_norm * 4.712;

    // o Makeup fica esmaecido quando esta sob comando automatico
    k_dim = (slot_i == 8 && auto_makeup) ? 0.45 : 1.0;

    col_track();
    thick_arc(k_cx, k_cy, k_r, -2.356, 2.356, 3);

    k_norm > 0.004 ? (
      col_accent(k_dim);
      thick_arc(k_cx, k_cy, k_r, -2.356, k_a, 3);
    );

    gfx_set(0.604, 0.639, 0.678, k_dim);
    gfx_line(k_cx, k_cy, k_cx + sin(k_a)*(k_r-6), k_cy - cos(k_a)*(k_r-6), 1);

    gfx_setfont(1, "Arial", 12);
    gfx_set(0.875, 0.894, 0.918, k_dim); txt_c(#k_val, k_cx, cell_y + 61);
  );

  slot_i += 1;
);

// botao de auto makeup
gfx_setfont(1, "Arial", 11, 'b');
auto_makeup ? (
  col_accent(1); gfx_rect(AMK_X, AMK_Y, AMK_W, AMK_H, 1);
  gfx_set(0.165, 0.102, 0.031, 1);
) : (
  gfx_set(0.106, 0.118, 0.137, 1); gfx_rect(AMK_X, AMK_Y, AMK_W, AMK_H, 1);
  gfx_set(0.227, 0.251, 0.282, 1); gfx_rect(AMK_X, AMK_Y, AMK_W, AMK_H, 0);
  gfx_set(0.667, 0.698, 0.741, 1);
);
txt_c("A", AMK_X + AMK_W*0.5, AMK_Y + 2);

// ---------------------------------------------------------------------
// Mouse
// ---------------------------------------------------------------------
mouse_down = (mouse_cap & 1) ? 1 : 0;

mouse_down && last_mouse_cap == 0 ? (
  active_knob = -1;
  current_time = time_precise();
  handled = 0;

  // seletor de fonte do VU
  (mouse_y >= PILL_Y && mouse_y <= PILL_Y + 19 &&
   mouse_x >= VU_X + 4 && mouse_x <= VU_X + 4 + 3*(PILL_W+2)) ? (
    slider13 = min(2, floor((mouse_x - VU_X - 4) / (PILL_W + 2)));
    slider_automate(slider13);
    handled = 1;
  );

  // botao de auto makeup, testado antes dos knobs porque fica sobre a celula
  (handled == 0 && mouse_x >= AMK_X && mouse_x <= AMK_X + AMK_W &&
   mouse_y >= AMK_Y && mouse_y <= AMK_Y + AMK_H) ? (
    slider14 = slider14 > 0.5 ? 0 : 1;
    slider_automate(slider14);
    handled = 1;
  );

  handled == 0 ? (
    check_i = 0;
    loop(12,
      c_col = check_i % 6;
      c_row = floor(check_i / 6);
      check_x = MARGIN + c_col * CELL_W + CELL_W * 0.5;
      check_y = (c_row == 0 ? ROW1_Y : ROW2_Y) + 38;

      abs(mouse_x - check_x) < 40 && abs(mouse_y - check_y) < 34 ? (
        is_alt_click = (mouse_cap & 16);
        is_double_click = (current_time - last_click_time < 0.3) && (last_clicked_knob == check_i);

        (is_alt_click || is_double_click) ? (
          check_i == 0 ? ( slider1 = 0; slider_automate(slider1); ) :
          check_i == 1 ? ( slider2 = 1; slider_automate(slider2); ) :
          check_i == 2 ? ( slider3 = 10; slider_automate(slider3); ) :
          check_i == 3 ? ( slider4 = 0.30; slider_automate(slider4); ) :
          check_i == 4 ? ( slider5 = 1; slider_automate(slider5); ) :
          check_i == 5 ? ( slider6 = 50; slider_automate(slider6); ) :
          check_i == 6 ? ( slider7 = 1; slider_automate(slider7); ) :
          check_i == 7 ? ( slider8 = 50; slider_automate(slider8); ) :
          check_i == 8 ? ( auto_makeup ? 0 : ( slider9 = 0; slider_automate(slider9); ); ) :
          check_i == 9 ? ( slider10 = 100; slider_automate(slider10); ) :
          check_i == 10 ? ( slider11 = 0; slider_automate(slider11); ) :
          check_i == 11 ? ( slider12 = 0; slider_automate(slider12); );

          active_knob = -1;
          last_click_time = 0;
        ) : (
          check_i == 1 ? ( slider2 = slider2 >= 4 ? 0 : slider2 + 1; slider_automate(slider2); ) :
          check_i == 4 ? ( slider5 = slider5 == 0 ? 1 : 0; slider_automate(slider5); ) :
          check_i == 6 ? ( slider7 = slider7 >= 2 ? 0 : slider7 + 1; slider_automate(slider7); ) : (
            active_knob = check_i;
            start_mouse_y = mouse_y;
            start_val_0 = slider1; start_val_2 = slider3;
            start_val_3 = slider4; start_val_5 = slider6;
            start_val_7 = slider8; start_val_8 = slider9;
            start_val_9 = slider10; start_val_10 = slider11;
            start_val_11 = slider12;
          );

          last_click_time = current_time;
          last_clicked_knob = check_i;
        );
      );
      check_i += 1;
    );
  );
);

mouse_down && active_knob >= 0 ? (
  drag_dy = start_mouse_y - mouse_y;
  sens = (mouse_cap & 12) ? 0.001 : 0.008;

  active_knob == 0 ? ( slider1 = min(15, max(-50, start_val_0 + drag_dy * 65 * sens)); slider_automate(slider1); ) :
  active_knob == 2 ? ( slider3 = min(30, max(0.1, start_val_2 + drag_dy * 29.9 * sens)); slider_automate(slider3); ) :
  active_knob == 3 ? ( slider4 = min(3.0, max(0.05, start_val_3 + drag_dy * 2.95 * sens)); slider_automate(slider4); ) :
  active_knob == 5 ? ( slider6 = min(100, max(0, floor(start_val_5 + drag_dy * 100 * sens + 0.5))); slider_automate(slider6); ) :
  active_knob == 7 ? ( slider8 = min(100, max(0, floor(start_val_7 + drag_dy * 100 * sens + 0.5))); slider_automate(slider8); ) :
  active_knob == 8 ? ( auto_makeup ? 0 : ( slider9 = min(24, max(0, start_val_8 + drag_dy * 24 * sens)); slider_automate(slider9); ); ) :
  active_knob == 9 ? ( slider10 = min(100, max(0, floor(start_val_9 + drag_dy * 100 * sens + 0.5))); slider_automate(slider10); ) :
  active_knob == 10 ? ( slider11 = min(100, max(0, floor(start_val_10 + drag_dy * 100 * sens + 0.5))); slider_automate(slider11); ) :
  active_knob == 11 ? ( slider12 = min(18, max(-18, start_val_11 + drag_dy * 36 * sens)); slider_automate(slider12); );
);

mouse_down == 0 ? active_knob = -1;
last_mouse_cap = mouse_down;

mouse_wheel != 0 ? (
  check_i = 0;
  loop(12,
    c_col = check_i % 6;
    c_row = floor(check_i / 6);
    check_x = MARGIN + c_col * CELL_W + CELL_W * 0.5;
    check_y = (c_row == 0 ? ROW1_Y : ROW2_Y) + 38;

    abs(mouse_x - check_x) < 40 && abs(mouse_y - check_y) < 34 ? (
      is_btn = (check_i == 1 || check_i == 4 || check_i == 6);
      is_btn == 0 ? (
        wheel_delta = mouse_wheel / 120;
        wheel_sens = (mouse_cap & 12) ? 0.005 : 0.025;

        check_i == 0 ? ( slider1 = min(15, max(-50, slider1 + wheel_delta * 65 * wheel_sens)); slider_automate(slider1); ) :
        check_i == 2 ? ( slider3 = min(30, max(0.1, slider3 + wheel_delta * 29.9 * wheel_sens)); slider_automate(slider3); ) :
        check_i == 3 ? ( slider4 = min(3.0, max(0.05, slider4 + wheel_delta * 2.95 * wheel_sens)); slider_automate(slider4); ) :
        check_i == 5 ? ( slider6 = min(100, max(0, floor(slider6 + wheel_delta * 100 * wheel_sens + 0.5))); slider_automate(slider6); ) :
        check_i == 7 ? ( slider8 = min(100, max(0, floor(slider8 + wheel_delta * 100 * wheel_sens + 0.5))); slider_automate(slider8); ) :
        check_i == 8 ? ( auto_makeup ? 0 : ( slider9 = min(24, max(0, slider9 + wheel_delta * 24 * wheel_sens)); slider_automate(slider9); ); ) :
        check_i == 9 ? ( slider10 = min(100, max(0, floor(slider10 + wheel_delta * 100 * wheel_sens + 0.5))); slider_automate(slider10); ) :
        check_i == 10 ? ( slider11 = min(100, max(0, floor(slider11 + wheel_delta * 100 * wheel_sens + 0.5))); slider_automate(slider11); ) :
        check_i == 11 ? ( slider12 = min(18, max(-18, slider12 + wheel_delta * 36 * wheel_sens)); slider_automate(slider12); );
      );
    );
    check_i += 1;
  );
  mouse_wheel = 0;
);
