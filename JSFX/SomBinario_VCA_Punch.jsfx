// @description SomBinario VCA Punch
// @author Jorge Araujo (SomBinario)
// @version 1.7.0
// @about
//   Bus Compressor VCA hibrido com circuito Thrust, focado em glue,
//   saturacao (THD) e controle de Crest Factor.
//
// ## v1.7.0
//
// - THRUST CORRIGIDO. O filtro agia sobre o sinal ja retificado, e nessa
//   posicao ele nao separava grave de agudo: a ondulacao da retificacao cai
//   sempre acima do corte, qualquer que seja a frequencia de entrada. Medido,
//   o controle em 100% variava meio decibel entre 40 Hz e 5 kHz, e ainda
//   AUMENTAVA o nivel do detector. Agora e um tilt linear de 3 dB por oitava
//   aplicado ao audio do sidechain antes da retificacao, como no API 2500:
//   -15 dB em 20 Hz, 0 dB em 632 Hz, +15 dB em 20 kHz com o knob no maximo.
//   Em 0% o filtro e transparente, entao Thrust desligado soa como antes.
// - Interface refeita: osciloscopio com a curva de reducao de ganho sobre o
//   envelope de nivel, linha do threshold, VU analogico com seletor de fonte
//   (out / in / gr) e knobs chapados.
//
// ## v1.6.0
//
// - Corrigidos os estalos ao mover os controles. THD, Makeup, Mix e Output
//   agora sao suavizados por amostra.
// - Corrigido o tranco ao tirar o THD do zero.
// - Novos valores padrao: Threshold 0 dB, THD 0%, Thrust 50%, Crest 50%.
//
// @links
//   Website https://sombinario.com.BR
// ------------------------------------------------------------------

desc:SomBinario VCA Punch v1.7.0 (SomBinario)
options: gfx_hz=60

slider1:0<-50,15,0.1>-Threshold (dB)
slider2:1<0,4,1{1.5:1,2:1,3:1,4:1,10:1}>-Ratio
slider3:10<0.1,30,0.1>-Attack (ms)
slider4:0.30<0.05,3,0.01>-Release (s)
slider5:1<0,1,1{Manual,Dual}>-Auto Release
slider6:50<0,100,1>-Crest Factor (%)
slider7:1<0,2,1{Soft,Medium,Hard}>-Knee
slider8:50<0,100,1>-Thrust (%)
slider9:0<0,24,0.1>-Makeup Gain (dB)
slider10:100<0,100,1>-Mix (%)
slider11:0<0,100,1>-THD (%)
slider12:0<-18,18,0.1>-Output Trim (dB)
slider13:0<0,2,1{out,in,gr}>-VU Source
slider14:0<0,1,1{Off,On}>-Auto Makeup

@init

// ---------------------------------------------------------------------
// Mapa de memoria
// ---------------------------------------------------------------------
gb_tbl   = 0;      // 256 pontos da curva medida do transformador

tilt_b0  = 300;    // coeficientes do filtro Thrust (7 secoes)
tilt_b1  = 310;
tilt_a1  = 320;

scl_x1   = 330;    // estados do tilt: sidechain, canal esquerdo
scl_y1   = 340;
scr_x1   = 350;    // sidechain, canal direito
scr_y1   = 360;
stl_x1   = 370;    // saturacao, canal esquerdo
stl_y1   = 380;
str_x1   = 390;    // saturacao, canal direito
str_y1   = 400;

scope_lvl = 1000;  // historico do nivel de saida, em dB
scope_gr  = 1400;  // historico da reducao de ganho, em dB
SCOPE_N   = 300;
scope_pos = 0;

// geometria da interface
MARGIN = 16;
VU_W   = 152;
CELL_W = 128;
CELL_H = 86;
ROW1_Y = 186;
ROW2_Y = 272;
SCOPE_X = MARGIN;
SCOPE_Y = 56;
SCOPE_W = 800 - MARGIN*2 - VU_W - 14;
SCOPE_H = 122;
SCOPE_PLOT_W = SCOPE_W - 34;
VU_X = 800 - MARGIN - VU_W;
VU_Y = 16;
VU_H = 138;
AMK_X = MARGIN + 2*CELL_W + CELL_W - 34;   // botao "A" na celula do Makeup
AMK_Y = ROW2_Y + 12;
AMK_W = 24;
AMK_H = 16;

PILL_Y = VU_Y + VU_H + 4;
PILL_W = floor((VU_W - 12) / 3);
DB_TOP = 0; DB_BOT = -54;
shown_gr = 0; shown_out = -60;
gr_hold = 0; out_hold = 0;

TILT_N   = 7;      // secoes do tilt
TILT_F0  = 15;     // faixa em que a inclinacao e valida
TILT_F1  = 15000;

// ---------------------------------------------------------------------
// Curva do transformador
// ---------------------------------------------------------------------
function gb_shaper(x) local(ax, findex, t0, t1, k, y)
(
  ax = min(abs(x), 1.0);
  findex = ax * 255.0;
  t0 = floor(findex);
  t1 = min(t0 + 1, 255);
  k = findex - t0;
  y = gb_tbl[t1]*k + gb_tbl[t0]*(1.0-k);
  (x < 0) ? -y : y;
);

// Limitador de pico usando a curva medida como formato do joelho.
// Tem ataque e release de verdade, em vez de redesenhar cada amostra isolada.
function gb_limiter_gain(peak_in, drive) local(driven, shaped)
(
  driven = peak_in * drive;
  shaped = gb_shaper(driven) / drive;
  (peak_in > 0.0001) ? min(1.0, shaped / peak_in) : 1.0;
);

// ---------------------------------------------------------------------
// THRUST
//
// Tilt linear de 3 dB por oitava, o inverso da curva do ruido rosa, como no
// circuito do API 2500. Aplicado ao AUDIO do sidechain, antes da retificacao.
//
// Ate a v1.6 o filtro agia sobre o sinal ja retificado. Nessa posicao ele nao
// funciona: retificar uma senoide produz um termo continuo e uma ondulacao no
// dobro da frequencia, e a razao entre os dois e fixa, nao importa a
// frequencia de entrada. Tanto 50 Hz quanto 5 kHz caiam inteiros no lado
// "alto" do filtro e recebiam o mesmo reforco.
//
// A inclinacao fracionaria e aproximada por secoes de primeira ordem, cada
// uma com um zero abaixo de um polo, espalhadas em escala logaritmica. A
// separacao entre zero e polo e proporcional ao knob, entao em 0% zero e polo
// coincidem e o filtro vira identidade.
// ---------------------------------------------------------------------
function make_tilt(thrust) local(total, perdb, step, r, i, c, fz, fp, a, b, inv, norm, maxf)
(
  thrust < 0.0005 ? (
    i = 0;
    loop(TILT_N,
      tilt_b0[i] = 1; tilt_b1[i] = 0; tilt_a1[i] = 0;
      i += 1;
    );
  ) : (
    total = 10 * log10(TILT_F1 / TILT_F0);
    perdb = total / TILT_N;
    step  = pow(TILT_F1 / TILT_F0, 1.0 / TILT_N);
    r     = sqrt(pow(10, perdb * thrust / 20));
    norm  = pow(10, -(10 * log10(632.5 / TILT_F0)) * thrust / 20);
    maxf  = 0.45 * srate;

    i = 0;
    loop(TILT_N,
      c  = TILT_F0 * pow(step, i + 0.5);
      fz = min(c / r, maxf);
      fp = min(c * r, maxf);
      a  = 1.0 / tan($pi * fz / srate);
      b  = 1.0 / tan($pi * fp / srate);
      inv = 1.0 / (1.0 + b);
      tilt_b0[i] = (1 + a) * inv;
      tilt_b1[i] = (1 - a) * inv;
      tilt_a1[i] = (1 - b) * inv;
      i += 1;
    );

    tilt_b0[0] *= norm;
    tilt_b1[0] *= norm;
  );
);

function tilt_run(x, xs, ys) local(i, y)
(
  i = 0;
  loop(TILT_N,
    y = tilt_b0[i]*x + tilt_b1[i]*xs[i] - tilt_a1[i]*ys[i];
    xs[i] = x;
    ys[i] = y;
    x = y;
    i += 1;
  );
  x;
);

// ---------------------------------------------------------------------
// Estado
// ---------------------------------------------------------------------
detector_rms = 0; peak_env = 0; gain_smoothed = 1; gr_db = 0; gr_meter = 0;
gb_env_l = 0; gb_env_r = 0;

thd_sm = 0; makeup_sm = 1; mix_sm = 1; out_sm = 1;
sm_init = 0;

out_peak = 0; in_peak = 0;
vu_sq_in = 0; vu_sq_out = 0; vu_db = -60;

last_thrust_c = -1; last_srate_c = -1;
auto_makeup = 0;

active_knob = -1; last_mouse_cap = 0;
start_mouse_y = 0;
start_val_0 = 0; start_val_2 = 0; start_val_3 = 0;
start_val_5 = 0; start_val_7 = 0; start_val_8 = 0;
start_val_9 = 0; start_val_10 = 0; start_val_11 = 0;
last_click_time = 0; last_clicked_knob = -1;

i = 0;
loop(SCOPE_N, scope_lvl[i] = -54; scope_gr[i] = 0; i += 1; );

// ---------------------------------------------------------------------
// Desenho
// ---------------------------------------------------------------------
function col_bg()      ( gfx_set(0.086, 0.094, 0.110, 1); );
function col_panel()   ( gfx_set(0.059, 0.067, 0.082, 1); );
function col_panelalt()( gfx_set(0.106, 0.118, 0.137, 1); );
function col_grid()    ( gfx_set(0.110, 0.125, 0.153, 1); );
function col_track()   ( gfx_set(0.157, 0.173, 0.200, 1); );
function col_accent(a) ( gfx_set(0.949, 0.545, 0.188, a); );
function col_signal(a) ( gfx_set(0.553, 0.584, 0.627, a); );
function col_label()   ( gfx_set(0.427, 0.463, 0.506, 1); );
function col_value()   ( gfx_set(0.875, 0.894, 0.918, 1); );
function col_title()   ( gfx_set(0.933, 0.945, 0.961, 1); );

function txt_c(str, cx, cy) local(w, h)
(
  gfx_measurestr(str, w, h);
  gfx_x = cx - w * 0.5; gfx_y = cy;
  gfx_drawstr(str);
);

function txt_r(str, rx, ty) local(w, h)
(
  gfx_measurestr(str, w, h);
  gfx_x = rx - w; gfx_y = ty;
  gfx_drawstr(str);
);

// arco espesso, desenhado como varios arcos concentricos
function thick_arc(cx, cy, r, a1, a2, th) local(i)
(
  i = 0;
  loop(th, gfx_arc(cx, cy, r - th*0.5 + i, a1, a2, 1); i += 1; );
);

function y_for_db(db) local(d)
(
  d = max(DB_BOT, min(DB_TOP, db));
  SCOPE_Y + (DB_TOP - d) / (DB_TOP - DB_BOT) * SCOPE_H;
);

slider_show(slider13, 0);   // fonte do VU: controlada pelos botoes da interface

  gb_tbl[0] = -0.000012846; gb_tbl[1] = 0.003919865; gb_tbl[2] = 0.007843877; gb_tbl[3] = 0.011762954; gb_tbl[4] = 0.015687751; gb_tbl[5] = 0.019609760; gb_tbl[6] = 0.023525846; gb_tbl[7] = 0.027455149;
